---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShopBar from '../components/ShopBar.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  shopBar?: { text?: string; href?: string; label?: string } | false;
  noindex?: boolean;
}
const { title, description, image = '/og.png', jsonLd = [], shopBar = {}, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const org: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
  slogan: site.tagline,
};
if (site.legalName) org.legalName = site.legalName;
if (site.email) org.email = site.email;
if (site.phone) org.telephone = site.phone;
const sameAs = Object.values(site.social).filter(Boolean);
if (sameAs.length) org.sameAs = sameAs;
const plausible = site.analytics.PLAUSIBLE_DOMAIN;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Every new page opens at the top (back/forward still returns to where you were; #links still jump to their section)
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if ((nav && nav.type === 'back_forward') || location.hash) return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var top = function () { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); };
        var touched = false;
        ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(function (e) { addEventListener(e, function () { touched = true; }, { passive: true, once: true }); });
        var maybeTop = function () { if (!touched) top(); };
        top(); addEventListener('DOMContentLoaded', maybeTop);
        addEventListener('load', function () { maybeTop(); setTimeout(function () { history.scrollRestoration = 'auto'; }, 50); });
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only z-50 rounded-full bg-ink px-5 py-3 text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <Header />
    <main id="main" class="relative isolate">
      <slot />
    </main>
    <Footer />
    <a href="#main" id="to-top" class="fixed right-5 bottom-24 z-30 grid h-12 w-12 translate-y-4 place-items-center rounded-full bg-white text-ink opacity-0 shadow-[0_10px_30px_-10px_rgba(26,26,26,0.4)] ring-1 ring-black/5 transition duration-300 hover:bg-ink hover:text-white lg:bottom-8" aria-label="Back to top" tabindex="-1"><svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    {shopBar !== false && <ShopBar {...shopBar} />}

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal], [data-unveil]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
      const tt = document.getElementById('to-top');
      if (tt) {
        const showTop = () => { const on = scrollY > 900; tt.classList.toggle('opacity-0', !on); tt.classList.toggle('translate-y-4', !on); tt.classList.toggle('pointer-events-none', !on); tt.tabIndex = on ? 0 : -1; };
        showTop(); addEventListener('scroll', showTop, { passive: true });
        tt.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
      }
      const bar = document.getElementById('progress');
      if (bar) {
        const upd = () => { const h = document.documentElement; bar.style.setProperty('--p', String(h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight))); };
        upd(); window.addEventListener('scroll', upd, { passive: true });
      }
    </script>
  </body>
</html>
