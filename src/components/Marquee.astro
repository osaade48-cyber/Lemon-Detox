---
/** Slowly drifting "Reset · Reduce · Restore" band. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const words = ['Reset', 'Reduce', 'Restore'];
const run = Array.from({ length: 6 }, () => words).flat();
---
<div class:list={['marquee-wrap overflow-hidden bg-lemon', cls]} aria-label="Reset · Reduce · Restore" role="img">
  <div class="marquee py-3.5 text-[0.72rem] font-bold uppercase tracking-[0.4em] text-ink" aria-hidden="true">
    {[0, 1].map(() => (
      <span class="flex shrink-0">{run.map((w) => <span class="flex items-center gap-10 pr-10">{w}<svg width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="2.2" fill="currentColor" /></svg></span>)}</span>
    ))}
  </div>
</div>
