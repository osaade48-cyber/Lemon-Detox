---
/**
 * Renders an optimised photo from src/assets/images/<name>.(avif|webp|png|jpg)
 * if it exists (AVIF + WebP, responsive widths). Otherwise renders the slot
 * fallback (illustration) so the page still looks finished.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** One name, or a list: the first photo that exists is used (lets a pending photo fall back to another). */
  name: string | string[];
  alt: string;
  class?: string;
  imgClass?: string;
  sizes?: string;
  eager?: boolean;
  [key: `data-${string}`]: unknown;
}
const { name, alt, class: cls = '', imgClass = 'h-full w-full object-cover', sizes = '(min-width: 1024px) 50vw, 100vw', eager = false, ...rest } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{avif,webp,png,jpg,jpeg}', { eager: true });
const names = Array.isArray(name) ? name : [name];
const base = (p: string) => p.split('/').pop()!.replace(/\.[^.]+$/, '');
const match = names.map((n) => Object.entries(files).find(([p]) => base(p) === n)).find(Boolean);
const img = match?.[1].default;
---
<div class:list={['relative overflow-hidden', cls]} {...rest}>
  {img ? (
    <Picture
      src={img}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600].filter((w) => w <= img.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class={imgClass}
    />
  ) : (
    <slot />
  )}
</div>
