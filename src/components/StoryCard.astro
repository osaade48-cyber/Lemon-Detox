---
import { Picture } from 'astro:assets';
import { photoFor, type Testimonial } from '../data/testimonials';
interface Props { t: Testimonial; class?: string; hidden?: boolean }
const { t, class: cls = '', hidden = false } = Astro.props;
const img = photoFor(t.photo);
const initials = t.name.replace(/[^A-Za-z& ]/g, '').split(/\s+/).filter((w) => w && !['&', 'Mr', 'Mrs'].includes(w)).slice(0, 2).map((w) => w[0]).join('');
const words = t.story.join(' ').split(/\s+/).length;
const long = words > 110;
---
<figure class:list={['story mb-6 break-inside-avoid card p-7 sm:p-8', cls]} data-category={t.category} hidden={hidden}>
  <div class="flex items-center gap-4">
    {img
      ? <Picture src={img} alt={`Portrait of ${t.name}`} formats={['avif', 'webp']} widths={[72, 144]} sizes="72px" loading="lazy" class="h-16 w-16 shrink-0 rounded-full object-cover object-top" />
      : <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-lemon-pale font-serif text-xl text-gold-deep" aria-hidden="true">{initials}</span>}
    <figcaption class="min-w-0 leading-snug">
      <span class="block font-semibold text-ink">{t.name}</span>
      {t.role && <span class="block text-sm text-ink-soft">{t.role}</span>}
      {t.location && <span class="block text-xs tracking-[0.12em] text-muted uppercase">{t.location}</span>}
    </figcaption>
  </div>
  {t.headline && <p class="mt-6 font-serif text-[1.55rem] leading-snug font-semibold text-ink">“{t.headline}”</p>}
  <blockquote class:list={['story-body relative mt-5 space-y-3 text-[0.95rem] leading-relaxed text-ink-soft [&_strong]:font-semibold [&_strong]:text-ink', long && 'is-clamped']}>
    {t.story.map((p) => <p set:html={p} />)}
  </blockquote>
  {long && <button type="button" class="story-more mt-3 text-sm font-semibold text-gold-deep underline decoration-gold-soft underline-offset-4 hover:decoration-gold-deep" aria-expanded="false">Read full story</button>}
</figure>
