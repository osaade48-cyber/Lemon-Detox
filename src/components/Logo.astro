---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
interface Props { light?: boolean; class?: string; eager?: boolean }
const { light = false, class: cls = 'h-11 w-auto', eager = false } = Astro.props;
---
{light ? (
  <span class:list={['inline-flex rounded-md bg-white px-3 py-2', cls.includes('h-') ? '' : '']}>
    <Image src={logo} alt="detox — Lemon Detox Cleanse" class={cls} widths={[160, 320]} sizes="160px" loading={eager ? 'eager' : 'lazy'} />
  </span>
) : (
  <Image src={logo} alt="detox — Lemon Detox Cleanse" class={cls} widths={[160, 320]} sizes="160px" loading={eager ? 'eager' : 'lazy'} />
)}
