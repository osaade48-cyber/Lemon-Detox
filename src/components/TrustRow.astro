---
interface Props { class?: string; items?: string[]; icons?: string[]; center?: boolean }
const { class: cls = '', items = ['Free tracked shipping Australia-wide', 'Secure checkout', '14-day returns on unopened boxes'], icons: names = ['truck', 'lock', 'return'], center = false } = Astro.props;
const icons: Record<string, string> = {
  truck: 'M2 5h11v9H2zM13 8h4l3 3v3h-7M5.5 17.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM16.5 17.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  lock: 'M5 10V7a5 5 0 0 1 10 0v3M4 10h12v8H4z',
  return: 'M4 10a6 6 0 1 0 2-4.5M4 3v3h3',
  leaf: 'M4 18C4 9 9 4 18 4c0 9-5 14-14 14zM4 18l8-8',
  calendar: 'M3 6h16v13H3zM3 10h16M7 3v4M15 3v4',
};
---
<ul class:list={['flex flex-wrap gap-x-7 gap-y-3 text-sm text-muted', center && 'justify-center', cls]}>
  {items.map((t, i) => (
    <li class="inline-flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 22 22" aria-hidden="true" class="shrink-0 text-gold-deep"><path d={icons[names[i]] ?? icons.truck} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {t}
    </li>
  ))}
</ul>
