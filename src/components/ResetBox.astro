---
/** Illustrated Reset Box — shown until real packaging photography is added. */
interface Props { label?: string; days?: number; class?: string }
const { label = 'Focused Cleanse', days = 7, class: cls = '' } = Astro.props;
const id = `rb${days}`;
---
<svg viewBox="0 0 320 340" class={cls} role="img" aria-label={`Lemon Detox Cleanse ${days}-day Reset Box`}>
  <defs>
    <linearGradient id={`${id}f`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F6DE5E"/><stop offset="1" stop-color="#EECD39"/></linearGradient>
    <linearGradient id={`${id}s`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#D9B52A"/><stop offset="1" stop-color="#C9A322"/></linearGradient>
    <radialGradient id={`${id}sh`} cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#1A1A1A" stop-opacity=".22"/><stop offset="1" stop-color="#1A1A1A" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse cx="160" cy="318" rx="140" ry="14" fill={`url(#${id}sh)`} />
  <!-- top -->
  <path d="M40 78 L70 52 L290 52 L260 78 Z" fill="#F9E98F" />
  <!-- side -->
  <path d="M260 78 L290 52 L290 286 L260 312 Z" fill={`url(#${id}s)`} />
  <!-- front -->
  <rect x="40" y="78" width="220" height="234" fill={`url(#${id}f)`} />
  <line x1="40" y1="78" x2="260" y2="78" stroke="#fff" stroke-opacity=".5" />
  <!-- logo -->
  <g transform="translate(150 150)" font-family="'Plus Jakarta Sans Variable', sans-serif" text-anchor="middle">
    <text x="-14" y="0" font-size="40" font-weight="800" fill="#1A1A1A" letter-spacing="-1.5">det</text>
    <g transform="translate(34 -13)">
      <circle r="14" fill="#FBEFA8"/><circle r="11.5" fill="#F5DE6E"/>
      <g stroke="#FBEFA8" stroke-width="1.6"><path d="M0-11.5v23M-11.5 0h23M-8.1-8.1l16.2 16.2M8.1-8.1-8.1 8.1"/></g>
    </g>
    <text x="61" y="0" font-size="40" font-weight="800" fill="#1A1A1A">x</text>
    <text x="0" y="22" font-size="7.5" font-weight="600" letter-spacing="3.2" fill="#1A1A1A">LEMON DETOX CLEANSE</text>
  </g>
  <line x1="90" y1="200" x2="210" y2="200" stroke="#1A1A1A" stroke-opacity=".25" />
  <text x="150" y="226" text-anchor="middle" font-family="'Cormorant Garamond', serif" font-size="17" font-style="italic" fill="#1A1A1A">Reset. Refine. Restore.</text>
  <text x="150" y="284" text-anchor="middle" font-family="'Plus Jakarta Sans Variable', sans-serif" font-size="8" font-weight="700" letter-spacing="2.6" fill="#1A1A1A" fill-opacity=".75">{days}-DAY {label.toUpperCase()}</text>
</svg>
