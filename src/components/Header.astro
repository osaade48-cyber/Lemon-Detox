---
import Logo from './Logo.astro';
import { site } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'Programs', href: '/#programs' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Testimonials', href: '/testimonials' },
  { label: 'FAQs', href: '/faqs' },
  { label: 'Stockists', href: '/stockists' },
];
const isActive = (href: string) => href !== '/#programs' && path.startsWith(href);
const cart = site.checkout.CART_URL;
---
<header id="site-header" class="sticky top-0 z-40 border-b border-black/[0.06] bg-paper/95 backdrop-blur-md">
  <div class="wrap flex h-[5.5rem] items-center justify-between gap-6 !max-w-[1320px]">
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-11 text-[0.8rem] font-normal tracking-[0.22em] uppercase">
        {nav.map((n) => (
          <li><a href={n.href} class:list={['relative py-2 text-ink-soft transition hover:text-ink', isActive(n.href) && 'text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[2px] after:bg-gold']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <button id="menu-btn" type="button" class="grid h-11 w-11 place-items-center rounded-full lg:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
      <span class="relative block h-3 w-5" aria-hidden="true">
        <span class="menu-line absolute left-0 top-0 h-[1.5px] w-5 bg-ink transition"></span>
        <span class="menu-line absolute left-0 bottom-0 h-[1.5px] w-5 bg-ink transition"></span>
      </span>
    </button>
    <div class="flex items-center gap-6 lg:gap-14">
      <a href={cart || '/#programs'} class="grid h-11 w-11 place-items-center text-ink hover:text-gold-deep" aria-label={cart ? 'Cart' : 'Shop the Reset Boxes'}><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l-1.2 13H6.2zM9 10V6a3 3 0 0 1 6 0v4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9.5 14.5a2.7 2.7 0 0 0 5 0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></a>
      <a href="/" class="shrink-0" aria-label="Lemon Detox Cleanse — home"><Logo eager class="h-11 w-auto sm:h-14" /></a>
    </div>
  </div>
  <span id="progress" class="absolute inset-x-0 -bottom-px h-[2px] bg-gold" aria-hidden="true"></span>
  <div id="mobile-menu" class="hidden border-t hairline bg-paper lg:hidden">
    <nav aria-label="Mobile" class="wrap py-6">
      <ul class="divide-y divide-black/[0.07]">
        {nav.map((n) => (
          <li><a href={n.href} class="flex items-center justify-between py-4 font-serif text-3xl text-ink" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}<span class="text-gold" aria-hidden="true">→</span></a></li>
        ))}
        {cart && <li><a href={cart} class="flex py-4 font-serif text-3xl text-ink">Cart</a></li>}
      </ul>
      <a href="/#programs" class="btn btn-primary btn-caps mt-6 w-full">Shop Reset Boxes</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const header = document.getElementById('site-header')!;
  const lines = btn.querySelectorAll<HTMLElement>('.menu-line');
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    lines[0].style.transform = open ? 'translateY(5px) rotate(45deg)' : '';
    lines[1].style.transform = open ? 'translateY(-5px) rotate(-45deg)' : '';
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
  });
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
