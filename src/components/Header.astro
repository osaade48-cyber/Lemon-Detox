---
import Logo from './Logo.astro';
import { site } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'Programs', href: '/#programs' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Stories', href: '/stories' },
  { label: 'FAQs', href: '/faqs' },
  { label: 'Contact', href: '/contact' },
];
const isActive = (href: string) => href !== '/#programs' && path.startsWith(href);
const cart = site.checkout.CART_URL;
---
<aside class="bg-ink text-cream" aria-label="Announcement">
  <p class="wrap py-2.5 text-center text-[0.78rem] tracking-[0.04em]">
    Free tracked shipping Australia-wide <span class="text-honey" aria-hidden="true">·</span><span class="sr-only">.</span> Reset your routine today
  </p>
</aside>
<header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-cream/85 backdrop-blur-md transition-colors duration-300 data-[scrolled]:border-gold-soft">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="Lemon Detox Cleanse — home"><Logo /></a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-9 text-[0.92rem] font-medium">
        {nav.map((n) => (
          <li><a href={n.href} class:list={['relative py-2 text-ink-soft transition hover:text-ink', isActive(n.href) && 'text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:bg-gold']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        {cart && <li><a href={cart} class="py-2 text-ink-soft hover:text-ink">Cart</a></li>}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#programs" class="btn btn-primary btn-sm hidden sm:inline-flex">Shop now</a>
      {cart && <a href={cart} class="grid h-11 w-11 place-items-center rounded-full lg:hidden" aria-label="Cart"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></a>}
      <button id="menu-btn" type="button" class="grid h-11 w-11 place-items-center rounded-full lg:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
        <span class="relative block h-3 w-5" aria-hidden="true">
          <span class="menu-line absolute left-0 top-0 h-[1.5px] w-5 bg-ink transition"></span>
          <span class="menu-line absolute left-0 bottom-0 h-[1.5px] w-5 bg-ink transition"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t hairline bg-cream lg:hidden" >
    <nav aria-label="Mobile" class="wrap py-6">
      <ul class="divide-y divide-gold-soft">
        {nav.map((n) => (
          <li><a href={n.href} class="flex items-center justify-between py-4 font-serif text-3xl text-ink" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}<span class="text-gold" aria-hidden="true">→</span></a></li>
        ))}
        {cart && <li><a href={cart} class="flex py-4 font-serif text-3xl text-ink">Cart</a></li>}
      </ul>
      <a href="/#programs" class="btn btn-primary mt-6 w-full">Shop the Reset Box</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const header = document.getElementById('site-header')!;
  const lines = btn.querySelectorAll<HTMLElement>('.menu-line');
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    lines[0].style.transform = open ? 'translateY(5px) rotate(45deg)' : '';
    lines[1].style.transform = open ? 'translateY(-5px) rotate(-45deg)' : '';
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
  });
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
