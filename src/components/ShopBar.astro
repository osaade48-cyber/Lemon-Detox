---
/** Slim sticky "Shop" bar on mobile, shown once the hero scrolls out of view. */
interface Props { text?: string; href?: string; label?: string }
const { text = 'From $95 · Free tracked shipping', href = '/#programs', label = 'Shop now' } = Astro.props;
---
<div id="shop-bar" class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t hairline bg-cream/95 backdrop-blur-md transition-transform duration-300 lg:hidden" aria-hidden="true" inert>
  <div class="wrap flex items-center justify-between gap-4 py-3" style="padding-bottom:max(0.75rem, env(safe-area-inset-bottom))">
    <span class="text-sm text-ink-soft">{text}</span>
    {href ? <a href={href} class="btn btn-primary btn-sm">{label}</a> : <span class="btn btn-primary btn-sm" aria-disabled="true">Coming soon</span>}
  </div>
</div>
<script>
  const bar = document.getElementById('shop-bar')!;
  const hero = document.querySelector('[data-hero]');
  const show = (on: boolean) => {
    bar.style.transform = on ? 'translateY(0)' : '';
    bar.toggleAttribute('inert', !on);
    bar.setAttribute('aria-hidden', String(!on));
  };
  if (hero) {
    new IntersectionObserver(([e]) => show(!e.isIntersecting && e.boundingClientRect.top < 0)).observe(hero);
  } else {
    const f = () => show(window.scrollY > 560);
    window.addEventListener('scroll', f, { passive: true });
  }
</script>
