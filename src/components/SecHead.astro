---
/** Consistent section header for How It Works: number, label, heading, gold rule, optional intro. */
interface Props { n: string; label: string; id: string; class?: string; center?: boolean }
const { n, label, id, class: cls = '', center = false } = Astro.props;
---
<div class:list={['max-w-2xl', center && 'mx-auto text-center', cls]} data-reveal>
  <div class:list={['flex items-end gap-4', center && 'justify-center']}>
    <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n={n} aria-hidden="true"></p>
    <p class="eyebrow pb-3">{label}</p>
  </div>
  <h2 id={id} class="mt-3 text-[clamp(2.1rem,3.6vw,3.2rem)] leading-[1.1]"><slot /></h2>
  <span class:list={['rule', center && 'mx-auto']} aria-hidden="true"></span>
  {Astro.slots.has('intro') && <div class="mt-6 text-[1.08rem] leading-[1.8] text-ink-soft"><slot name="intro" /></div>}
</div>
