---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { type ShopItem, money, orderLink } from '../data/shop';
interface Props { item: ShopItem; delay?: number }
const { item: it, delay = 0 } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>(['/src/assets/products/*.{jpg,png,webp}', '/src/assets/images/*.{jpg,png,webp}'], { eager: true });
const img = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.[^.]+$/, '') === it.image)?.[1].default;
const v0 = it.variants?.[0];
const price = v0?.price ?? it.price;
const was = v0?.was ?? it.was;
const href = (v0?.checkout ?? it.checkout) || orderLink(v0 ? `${it.name} (${v0.label})` : it.name);
const live = !!(v0?.checkout ?? it.checkout);
---
<article class="shop-card lift group flex flex-col overflow-hidden rounded-[22px] border border-black/[0.06] bg-white shadow-[0_2px_6px_rgba(26,26,26,0.03),0_20px_40px_-30px_rgba(26,26,26,0.3)]" data-reveal style={`--d:${delay}ms`} data-name={it.name}>
  <div class:list={['relative overflow-hidden', it.photo ? 'bg-[#e9e9e9]' : 'bg-white px-6 py-3']}>
    {it.href && <a href={it.href} class="absolute inset-0 z-[1]" aria-label={`${it.name} — details`} tabindex="-1"></a>}
    {img && <Picture src={img} alt={`${it.name}${it.size ? ' ' + it.size : ''}`} formats={['avif', 'webp']} widths={[480, 800, 1200]} quality={90} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw" loading="lazy" class:list={['h-auto w-full transition duration-700 group-hover:scale-[1.04]', it.photo ? 'aspect-[3/2] object-cover' : 'aspect-[3/2] object-contain']} />}
    {it.badge && <span class="absolute top-4 left-4 z-[2] rounded-full bg-gold-deep px-3 py-1 text-[0.6rem] font-semibold tracking-[0.2em] text-white uppercase">{it.badge}</span>}
    {it.variants?.some((v) => v.was) || was ? <span class:list={['sale-flag absolute top-4 right-4 z-[2] rounded-full bg-lemon px-3 py-1 text-[0.6rem] font-bold tracking-[0.2em] text-ink uppercase', !was && 'hidden']}>{was ? `Save ${money(was - price)}` : ''}</span> : null}
  </div>
  <div class="flex flex-1 flex-col border-t border-black/[0.05] p-6">
    {it.size && !it.variants && <p class="text-[0.66rem] tracking-[0.2em] text-muted uppercase">{it.size}</p>}
    <h3 class="mt-1 text-[1.35rem] leading-snug">{it.href ? <a href={it.href} class="transition hover:text-gold-deep">{it.name}</a> : it.name}</h3>
    <p class="mt-2 text-[0.94rem] leading-relaxed text-ink-soft">{it.blurb}</p>
    {it.variants && (
      <fieldset class="mt-4">
        <legend class="text-[0.66rem] tracking-[0.2em] text-muted uppercase">Size</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {it.variants.map((v, i) => (
            <label class="cursor-pointer">
              <input type="radio" name={`size-${it.id}`} value={v.label} class="peer sr-only" checked={i === 0}
                data-price={v.price} data-was={v.was ?? ''} data-href={v.checkout || orderLink(`${it.name} (${v.label})`)} data-live={v.checkout ? '1' : ''} />
              <span class="block rounded-full border border-black/15 px-3.5 py-1.5 text-sm text-ink-soft transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-honey">{v.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}
    {it.note && <p class="mt-3 text-xs leading-relaxed text-muted">{it.note}</p>}
    <div class="mt-auto flex items-center justify-between gap-3 pt-6">
      <p class="leading-none">
        <span class="js-price font-serif text-[1.8rem] text-ink">{money(price)}</span>
        <s class:list={['js-was ml-1.5 text-sm text-muted', !was && 'hidden']}>{was ? money(was) : ''}</s>
      </p>
      <a href={href} class="js-buy btn btn-primary btn-caps btn-sm !px-5" rel={live ? 'noopener' : undefined}>{live ? 'Buy now' : 'Order now'}</a>
    </div>
    {it.href && <a href={it.href} class="link-arrow mt-4 self-start text-sm">{it.category === 'programs' ? 'View details' : 'Details & how to use'}</a>}
  </div>
</article>
