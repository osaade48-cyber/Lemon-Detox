---
import type { Product } from '../data/products';
import ResetBox from './ResetBox.astro';
import ImageSlot from './ImageSlot.astro';
import BuyButton from './BuyButton.astro';
import PriceNote from './PriceNote.astro';
import LemonSlice from './LemonSlice.astro';
interface Props { product: Product; delay?: number }
const { product: p, delay = 0 } = Astro.props;
const featured = !!p.badge;
const label = p.name.replace(/^\d+-Day /, '');
---
<article
  class:list={['card card-hover group relative flex flex-col overflow-hidden', featured && 'border-gold/60']}
  data-reveal style={`--d:${delay}ms`}
  aria-labelledby={`pc-${p.slug}`}
>
  <a href={`/products/${p.slug}`} class="relative block" tabindex="-1" aria-hidden="true">
    <ImageSlot name={`product-${p.days}day`} alt="" class:list={['aspect-[5/4]', featured ? 'bg-honey/45' : 'bg-lemon-pale/45']} sizes="(min-width: 768px) 560px, 100vw">
      <LemonSlice class="absolute -right-16 -bottom-16 h-56 w-56 opacity-60" />
      <ResetBox days={p.days} label={label} class="relative mx-auto h-full w-auto py-6 transition duration-500 group-hover:-translate-y-1" />
    </ImageSlot>
    {p.badge && <span class="absolute top-5 left-5 rounded-full bg-ink px-3.5 py-1.5 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-cream">{p.badge}</span>}
  </a>
  <div class="flex flex-1 flex-col p-7 sm:p-9">
    <p class="eyebrow">{p.eyebrow}</p>
    <h3 id={`pc-${p.slug}`} class="mt-3 text-[2.15rem] sm:text-[2.5rem]">
      <a href={`/products/${p.slug}`} class="hover:text-gold-deep">{p.name}</a>
    </h3>
    <p class="mt-3 text-ink-soft">{p.cardLine}</p>
    <p class="mt-2 text-sm text-muted">{p.cardIncludes}</p>
    <div class="mt-auto pt-8">
      <div class="flex items-baseline gap-2 border-t hairline pt-6">
        <span class="font-serif text-5xl text-ink">${p.price}</span>
        <span class="text-sm font-semibold tracking-wide text-muted">AUD</span>
        <span class="ml-auto text-sm text-muted">${(p.price / p.days).toFixed(2)} / day</span>
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
        <BuyButton href={p.checkoutUrl} product={p.name} />
        <a href={`/products/${p.slug}`} class="link-arrow text-sm">View details</a>
      </div>
      <PriceNote class="mt-4" />
    </div>
  </div>
</article>
