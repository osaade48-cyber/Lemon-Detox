---
import Base from '../layouts/Base.astro';
import LemonSlice from '../components/LemonSlice.astro';
---
<Base title="Page not found — Lemon Detox Cleanse" description="This page couldn't be found." noindex shopBar={false}>
  <section class="relative overflow-hidden">
    <div class="wrap grid min-h-[70vh] items-center gap-12 py-24 md:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="eyebrow">404</p>
        <h1 class="display-xl mt-6 !text-[clamp(3rem,8vw,6.5rem)]">This page has been <em>squeezed.</em></h1>
        <p class="lead mt-8 max-w-md">We couldn't find what you were looking for. Let's get you back on track.</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/#programs" class="btn btn-secondary">Shop the Reset Box</a>
        </div>
      </div>
      <LemonSlice class="mx-auto h-64 w-64 opacity-80 md:h-96 md:w-96" />
    </div>
  </section>
</Base>
