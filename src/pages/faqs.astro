---
import Base from '../layouts/Base.astro';
import Accordion from '../components/Accordion.astro';
import LemonSlice from '../components/LemonSlice.astro';
import { site } from '../config/site';

const metro = site.shipping.metro;
type QA = { q: string; a: string };
const groups: { id: string; title: string; items: QA[] }[] = [
  { id: 'getting-started', title: 'Getting started', items: [
    { q: 'How long should I do the cleanse for?', a: "Most people do 7 to 14 days. We don't recommend fewer than five days — it usually takes the first two or three days to settle into the routine. The 7-Day Focused Cleanse suits first-timers; the 14-Day Extended Cleanse is for a deeper reset." },
    { q: 'Which way should I follow it — Full Cleanse, Relaxed or 50/50?', a: 'Full Cleanse gives the deepest reset. Relaxed keeps one light meal a day and suits busy weeks. 50/50 eases you in and out. See <a href="/how-it-works#three-ways"><em>How It Works</em></a> for the details.' },
    { q: 'What do I need to buy as well as the Reset Box?', a: 'Fresh lemons (about 25 for 7 days), cayenne pepper and water. Everything else is in the box.' },
    { q: 'How do I prepare the drink?', a: `Full measures for a daily 2-litre batch and a single glass are on the <a href="/how-it-works#mixing"><em>How It Works</em></a> page and in the <a href="${site.guidePdf}" download>Program Guide</a>.` },
  ]},
  { id: 'during', title: 'During the cleanse', items: [
    { q: 'Will I be hungry?', a: 'Some hunger on Days 1–2 is normal. Have a glass of the drink whenever you feel hungry — most people have six to nine glasses a day. Many say hunger eases noticeably by Day 3.' },
    { q: 'Do I have to do the salt-water flush?', a: "No. If you don't like it — or if you have high blood pressure, heart or kidney conditions — use a cup of senna herbal tea in the morning instead." },
    { q: 'Can I drink anything else?', a: 'Plain water (1–2 litres a day), and herbal teas such as peppermint, chamomile or rosehip. If you want sweetness, use a little tree syrup only. Avoid dairy, alcohol and soft drinks.' },
    { q: 'What about coffee?', a: 'We recommend cutting back gradually in the week before you start, as headaches on Days 1–2 are common for regular coffee drinkers.' },
    { q: 'Can I exercise?', a: 'Yes — gently. Walking, stretching and light yoga are fine. Avoid intense or long training sessions during the cleanse and return to your usual routine afterwards.' },
    { q: 'Is lemon juice too acidic on an empty stomach?', a: 'The drink is diluted, and most people find it comfortable. If you have reflux or a sensitive stomach, check with your doctor before starting.' },
  ]},
  { id: 'afterwards', title: 'Afterwards', items: [
    { q: 'How do I come off the cleanse?', a: 'Ease back in over two or three days: juices and vegetable soup first, then fruit, salads and vegetables, then lean protein and whole grains.' },
    { q: 'Will the weight come back?', a: 'That depends on what you do next. Many people find the cleanse breaks old eating patterns and makes it easier to keep up healthier habits afterwards. If you go straight back to your old routine, expect some weight to return.' },
    { q: 'How often can I repeat it?', a: 'Many people do the cleanse once or twice a year. Leave at least 4 weeks between full programs.' },
  ]},
  { id: 'safety', title: 'Safety', items: [
    { q: "Who shouldn't do the cleanse?", a: "Anyone pregnant or breastfeeding, under 18, living with diabetes, heart, kidney or liver disease, high or low blood pressure, with a history of eating disorders, recovering from surgery or illness, or taking prescription medication without their doctor's approval." },
    { q: 'I take medication. Can I do it?', a: 'Please speak with your doctor before starting. A big change in food intake can affect how some medications work.' },
    { q: 'What if I feel unwell?', a: 'Mild headaches and tiredness early on are common. If you feel faint, dizzy, or have palpitations or anything that worries you, stop the cleanse, eat normally and seek medical advice.' },
  ]},
  { id: 'orders', title: 'Orders', items: [
    { q: 'How long does shipping take?', a: metro
      ? `See <a href="/shipping"><em>Shipping</em></a> — ${metro} business days for most of Australia, free tracked shipping on every order.`
      : 'See <a href="/shipping"><em>Shipping</em></a> — free tracked shipping on every order.' },
    { q: 'Can I return my Reset Box?', a: 'Unopened boxes can be returned within 14 days. See <a href="/returns"><em>Returns &amp; Refunds</em></a>.' },
  ]},
];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) => g.items).map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, '') } })),
}];
---
<Base title="FAQs — Lemon Detox Cleanse" description="Answers on hunger, coffee, exercise, safety, shipping and more." jsonLd={jsonLd}>
  <section class="relative overflow-hidden" data-hero>
    <LemonSlice class="pointer-events-none absolute -top-32 -right-32 h-[28rem] w-[28rem] opacity-80" spin />
    <div class="wrap relative pt-16 pb-16 sm:pt-24 sm:pb-20">
      <p class="eyebrow">FAQs</p>
      <h1 class="display-xl mt-6 max-w-4xl !text-[clamp(3rem,7vw,6rem)]">Everything you've wondered about the <em>cleanse.</em></h1>
      <p class="lead mt-8 max-w-xl">Straight answers to the questions we're asked most.</p>
    </div>
  </section>

  <div class="wrap grid gap-12 pb-24 lg:grid-cols-[220px_1fr] lg:gap-20">
    <nav aria-label="FAQ topics" class="lg:sticky lg:top-32 lg:self-start">
      <ul class="flex flex-wrap gap-2 lg:flex-col lg:gap-1">
        {groups.map((g) => <li><a href={`#${g.id}`} class="block rounded-full border hairline px-4 py-2 text-sm text-ink-soft hover:border-ink hover:text-ink lg:rounded-none lg:border-0 lg:border-l lg:px-5">{g.title}</a></li>)}
      </ul>
    </nav>
    <div class="space-y-20">
      {groups.map((g) => (
        <section id={g.id} aria-labelledby={`${g.id}-h`} class="scroll-mt-32">
          <h2 id={`${g.id}-h`} class="eyebrow border-b hairline pb-4">{g.title}</h2>
          {g.items.map((i) => <Accordion q={i.q}><p set:html={i.a} /></Accordion>)}
        </section>
      ))}
    </div>
  </div>

  <section class="pb-28">
    <div class="wrap">
      <div class="flex flex-col items-start justify-between gap-8 rounded-[22px] bg-lemon p-10 sm:p-14 md:flex-row md:items-center">
        <div>
          <h2 class="display-md">Still have a <em>question?</em></h2>
          <p class="mt-3 text-ink-soft">Our team usually replies within one business day.</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="btn btn-primary">Contact us</a>
          <a href="/how-it-works" class="btn btn-secondary">How it works</a>
        </div>
      </div>
    </div>
  </section>
</Base>
