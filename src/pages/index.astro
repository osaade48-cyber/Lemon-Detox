---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import GuideRequest from '../components/GuideRequest.astro';
import CTA from '../components/CTA.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { products } from '../data/products';
import { homeCards, photoFor } from '../data/testimonials';

const supports = [
  'Weight loss, with 3–6kg in 10 days commonly reported',
  'Better energy and endurance',
  'Stronger self-discipline',
  'Improved confidence and motivation',
  'Greater awareness around eating habits',
  'Brighter-looking skin',
  'A greater sense of wellbeing',
  'Renewed vitality',
];

const voices = homeCards.map((c) => ({ ...c, img: photoFor(c.photo.replace('.jpeg', '-large.jpg')) ?? photoFor(c.photo) }));
---
<Base
  title="Lemon Detox Cleanse — 7 & 14 Day Reset Box"
  description="A structured 7 or 14 day lemon cleanse built around one simple drink. Free tracked shipping Australia-wide."
>
  <!-- Hero (Manus layout): full-bleed photo, white fade from the left, headline left -->
  <section class="relative isolate flex flex-col overflow-hidden bg-white" data-hero>
    <!-- Desktop: photo fills the hero behind the headline. Phones: headline first, then the whole photo uncropped. -->
    <div class="wrap !max-w-[1320px] order-1 flex flex-col pt-10 pb-8 sm:pt-14 lg:h-[min(calc(100svh-5.5rem),52vw)] lg:min-h-[600px] lg:justify-center lg:py-0">
      <div class="hero-in max-w-[40rem]">
        <h1 class="display-xl !text-[clamp(3rem,6.6vw,6.4rem)] !leading-[1.04]">Reset. Reduce.<br /><em>Restore.</em></h1>
        <p class="eyebrow mt-5 !text-[0.75rem] !tracking-[0.42em] lg:mt-8 lg:!text-[0.85rem]">Lemon Detox Cleanse</p>
        <div class="mt-7 flex flex-wrap gap-3 lg:mt-10 lg:gap-4">
          <a href="/#programs" class="btn btn-primary btn-caps !min-h-[3.25rem] !px-6 lg:!min-h-[4rem] lg:!px-9 shadow-[0_18px_30px_-16px_rgba(26,26,26,0.5)]">Shop Reset Boxes <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href="/how-it-works" class="btn btn-secondary btn-caps !min-h-[3.25rem] !border-ink/50 !bg-white/60 !px-6 lg:!min-h-[4rem] lg:!px-9 backdrop-blur-sm">How it works</a>
        </div>
      </div>
    </div>
    <div class="order-2 relative aspect-[1672/941] w-full lg:absolute lg:inset-0 lg:-z-20 lg:aspect-auto">
      <ImageSlot name="hero-banner" alt="A woman at a sunlit marble bench with Lemon Detox Cleanse Reset Boxes, the Madal Bal Natural Tree Syrup tin, a jug of the Lemon Detox drink and fresh lemons" eager class="breathe h-full w-full" imgClass="h-full w-full object-cover object-[50%_55%]" sizes="100vw" />
      <div class="absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-white to-white/0 lg:hidden"></div>
    </div>
    <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-white/95 via-white/70 via-35% to-white/0 to-60% lg:block"></div>
  </section>

  <!-- Reset behaviour (white) -->
  <section class="py-20 lg:py-32" aria-labelledby="reset-h">
    <div class="wrap !max-w-[1320px] grid items-center gap-14 lg:grid-cols-[0.8fr_1fr] lg:gap-24">
      <ImageSlot name="home-reset" alt="A woman stretching outdoors in the morning sun with a glass of the Lemon Detox drink" class="zoom-img aspect-[4/5] rounded-[28px] bg-paper shadow-[0_40px_60px_-40px_rgba(26,26,26,0.35)]" sizes="(min-width: 1024px) 560px, 100vw" data-unveil />
      <div data-reveal>
        <span class="chip">Reset behaviour</span>
        <h2 id="reset-h" class="display-lg mt-7 !text-[clamp(2.4rem,4.6vw,4.4rem)]">In a world of <em>constant consumption</em>.</h2>
        <span class="rule" aria-hidden="true"></span>
        <p class="mt-8 text-[1.2rem] leading-[1.85] text-ink-soft">The Lemon Detox Cleanse provides a defined timeframe, a clear routine, and a temporary step away from solid food. Most diets focus on restriction. This program focuses on resetting behaviour.</p>
        <p class="mt-6 text-[1.2rem] leading-[1.85] text-ink-soft">No confusion. No complicated rules.<br />Just clarity and simplicity.</p>
      </div>
    </div>
  </section>

  <!-- What changes (off-white) -->
  <section class="bg-paper py-20 lg:py-32" aria-labelledby="system-h">
    <div class="wrap !max-w-[1320px]">
      <div data-reveal>
        <span class="chip">What changes</span>
        <h2 id="system-h" class="display-lg mt-7 !text-[clamp(2.4rem,4.6vw,4.4rem)]">Every system benefits from <em>a reset</em>.</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>
      <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-24">
        <div class="space-y-7 text-[1.2rem] leading-[1.85] text-ink-soft" data-reveal>
          <p>Our bodies are no exception. For many participants, weight loss occurs as a natural outcome of temporarily removing solid food and simplifying intake. The Lemon Detox Cleanse is designed to create that defined pause — supporting recalibration and renewed awareness.</p>
          <p>More importantly, this structured reset often helps re-establish healthier habits — creating a strong foundation for maintaining results when continued with balanced, mindful choices.</p>
        </div>
        <div data-reveal style="--d:120ms">
          <h3 class="font-sans text-[0.85rem] font-semibold tracking-[0.28em] text-gold-deep uppercase">In addition, the program supports:</h3>
          <ul class="mt-7 space-y-4 text-[1.15rem] text-ink-soft">
            {supports.map((s) => <li class="flex items-start gap-5"><span class="mt-[0.7em] h-2 w-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>{s}</li>)}
          </ul>
          <p class="mt-7 text-xs text-muted">Individual results vary.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Programs (white) -->
  <section id="programs" class="scroll-mt-24 py-20 lg:py-28" aria-labelledby="programs-h">
    <div class="wrap !max-w-[1320px]">
      <div data-reveal>
        <p class="eyebrow">Select your program</p>
        <h2 id="programs-h" class="display-lg mt-3 !text-[clamp(2.4rem,4.4vw,4rem)]">Choose your <em>cleanse</em>.</h2>
      </div>
      <div class="mx-auto mt-14 grid max-w-[1160px] gap-8 md:grid-cols-2">
        {products.map((p, i) => <ProductCard product={p} delay={i * 120} />)}
      </div>
      <p class="mt-10 text-center text-sm text-muted">Free tracked shipping Australia-wide · Secure checkout · 14-day returns on unopened boxes</p>
    </div>
  </section>

  <GuideRequest />

  <!-- Voices from the cleanse (off-white) -->
  <section class="bg-paper py-20 lg:py-28" aria-labelledby="voices-h">
    <div class="wrap !max-w-[1320px]">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Trusted for decades.</p>
        <h2 id="voices-h" class="display-lg mt-4 !text-[clamp(2.4rem,4.4vw,4rem)]">Everyday People. <em>Real Stories.</em></h2>
        <span class="rule" aria-hidden="true"></span>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {voices.map((c, i) => (
          <figure class="lift flex flex-col overflow-hidden rounded-[22px] bg-white text-center shadow-[0_2px_6px_rgba(26,26,26,0.04),0_20px_40px_-28px_rgba(26,26,26,0.3)]" data-reveal style={`--d:${i * 90}ms`}>
            <div class="h-64 overflow-hidden bg-white">
              {c.img && <Picture src={c.img} alt={`Portrait of ${c.name}`} formats={['avif', 'webp']} widths={[380, Math.min(c.img.width, 760)]} quality={90} sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw" class="h-full w-full object-contain object-bottom" />}
            </div>
            <div class="relative flex flex-1 flex-col px-6 pt-10 pb-8">
              <svg class="absolute inset-x-0 -top-px w-full text-black/[0.08]" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M0 16 Q150 -12 300 16" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
              <span class="absolute top-0 left-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-gold shadow-[0_0_0_1px_rgba(26,26,26,0.07)]" aria-hidden="true"><svg width="18" height="14" viewBox="0 0 28 22"><path d="M0 22V12.7C0 5.4 4.2 1.2 11 0l1.2 2.6C8 4 6 6.6 5.8 10H11v12H0zm16 0V12.7C16 5.4 20.2 1.2 27 0l1 2.6C24 4 22 6.6 21.8 10H27v12H16z" fill="currentColor"/></svg></span>
              <blockquote class="flex-1 font-serif text-[1.2rem] leading-[1.5] text-ink">“{c.quote}”</blockquote>
              <figcaption class="mt-6">
                <span class="block font-serif text-[1.15rem] text-ink">{c.name}</span>
                {c.role && <span class="mt-1 block text-[0.68rem] tracking-[0.22em] text-muted uppercase">{c.role}</span>}
                <span class="mt-1 block text-[0.68rem] tracking-[0.22em] text-muted uppercase">{c.location}</span>
              </figcaption>
            </div>
          </figure>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/testimonials" class="btn btn-secondary btn-caps !min-h-[3.5rem] !px-9">Read more testimonials</a>
        <p class="mt-5 text-xs text-muted">Individual results vary.</p>
      </div>
    </div>
  </section>

  <CTA />
</Base>
