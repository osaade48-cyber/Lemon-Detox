---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import TrustRow from '../components/TrustRow.astro';
import GuideRequest from '../components/GuideRequest.astro';
import CTA from '../components/CTA.astro';
import Marquee from '../components/Marquee.astro';
import LemonSlice from '../components/LemonSlice.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { products } from '../data/products';
import { homeCards, photoFor } from '../data/testimonials';
import { site } from '../config/site';

const supports = [
  'Weight loss, with 3–6kg in 10 days commonly reported',
  'Better energy and endurance',
  'Stronger self-discipline',
  'Improved confidence and motivation',
  'Greater awareness around eating habits',
  'Brighter-looking skin',
  'A greater sense of wellbeing',
  'Renewed vitality',
];

const ritual = [
  { when: 'Morning', line: 'Begin with the elimination routine, then mix the day’s drink.', img: ['hiw-morning'], alt: 'A sunny terrace table set with the Lemon Detox drink, lemons and the Madal Bal tin' },
  { when: 'Through the day', line: 'Sip the Lemon Detox drink whenever you feel hungry.', img: ['hiw-day'], alt: 'A woman smiling with a glass of the Lemon Detox drink beside a jug and fresh lemons' },
  { when: 'Evening', line: 'A cup of senna tea, then a good night’s rest.', img: ['evening-calm', 'senna-tea'], alt: 'A glass cup of senna tea by candlelight' },
];
---
<Base
  title="Lemon Detox Cleanse — 7 & 14 Day Reset Box"
  description="A structured 7 or 14 day lemon cleanse built around one simple drink. Free tracked shipping Australia-wide."
>
  <!-- Hero banner: full width. Headline sits on the bright wall in the photo on wide screens, above it on smaller screens. -->
  <section class="relative overflow-hidden bg-[#f6efe2]" data-hero>
    <div class="wrap pt-10 pb-8 text-center sm:pt-14 xl:hidden" data-reveal>
      <p class="eyebrow">Lemon Detox Cleanse</p>
      <h1 class="display-xl mt-5 !text-[clamp(2.9rem,9vw,4.75rem)]">Reset. Reduce. <em>Restore.</em></h1>
      <p class="lead mx-auto mt-5 max-w-md">A structured lemon cleanse program.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/#programs" class="btn btn-primary btn-caps">Start your reset</a>
        <a href="/how-it-works" class="btn btn-secondary btn-caps">How it works</a>
      </div>
    </div>
    <div class="relative">
      <ImageSlot name="hero-banner" alt="A woman at a sunlit marble bench with Lemon Detox Cleanse Reset Boxes, the Madal Bal Natural Tree Syrup tin, a jug of the Lemon Detox drink and fresh lemons" eager class="breathe aspect-[16/10] w-full sm:aspect-[16/9]" imgClass="h-full w-full object-cover object-[60%_50%]" sizes="100vw" />
      <div class="pointer-events-none absolute inset-y-0 left-[39.5%] hidden w-[29%] items-start pt-[3.2%] xl:flex">
        <div class="pointer-events-auto relative" data-reveal>
          <div class="absolute -inset-10 -z-10 rounded-full bg-[radial-gradient(closest-side,rgba(255,250,240,0.85),rgba(255,250,240,0))]"></div>
          <p class="eyebrow">Lemon Detox Cleanse</p>
          <h1 class="display-xl mt-3 !text-[clamp(2.8rem,3.9vw,4.1rem)] !leading-[0.98]">Reset.<br />Reduce.<br /><em>Restore.</em></h1>
          <p class="mt-4 text-ink-soft">A structured lemon cleanse program.</p>
          <div class="mt-5 flex flex-nowrap gap-3">
            <a href="/#programs" class="btn btn-primary btn-sm btn-caps min-[1440px]:min-h-[3.25rem] min-[1440px]:px-7">Start your reset</a>
            <a href="/how-it-works" class="btn btn-secondary btn-sm btn-caps !bg-white/60 backdrop-blur min-[1440px]:min-h-[3.25rem] min-[1440px]:px-7">How it works</a>
          </div>
        </div>
      </div>
    </div>
    <Marquee />
  </section>

  <!-- Structure & simplicity (white) -->
  <section class="py-24 sm:py-32" aria-labelledby="reset-h">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <ImageSlot name="home-reset" alt="A woman stretching outdoors in the morning sun with a glass of the Lemon Detox drink" class="zoom-img aspect-[4/5] rounded-card bg-paper" sizes="(min-width: 1024px) 560px, 100vw" data-unveil />
      <div data-reveal>
        <p class="eyebrow mb-5">Reset behaviour</p>
        <h2 id="reset-h" class="display-lg">In a world of constant consumption, take a <em>defined pause.</em></h2>
        <div class="mt-8 space-y-5 text-ink-soft">
          <p class="text-lg font-semibold text-ink">The Lemon Detox Cleanse is built on structure and simplicity.</p>
          <p>The Lemon Detox Cleanse provides a defined timeframe, a clear routine, and a temporary step away from solid food. Most diets focus on restriction. This program focuses on resetting behaviour.</p>
          <p class="font-serif text-2xl font-semibold leading-snug text-ink">No confusion. No complicated rules.<br />Just clarity and simplicity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Every system benefits from a reset (#faf9f6) -->
  <section class="texture overflow-hidden bg-paper py-24 sm:py-32" aria-labelledby="system-h">
    <LemonSlice class="pointer-events-none absolute -right-32 -bottom-32 h-96 w-96 opacity-[0.12]" />
    <div class="wrap grid gap-14 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <div data-reveal>
        <h2 id="system-h" class="display-lg">Every system benefits from <span class="text-gold-deep italic">a reset.</span></h2>
        <div class="mt-8 space-y-5 text-ink-soft">
          <p class="text-lg font-semibold text-ink">Our bodies are no exception.</p>
          <p>For many participants, weight loss occurs as a natural outcome of temporarily removing solid food and simplifying intake.<br class="hidden xl:block" /> The Lemon Detox Cleanse is designed to create that defined pause — supporting recalibration and renewed awareness.</p>
          <p>More importantly, this structured reset often helps re-establish healthier habits — creating a strong foundation for maintaining results when continued with balanced, mindful choices.</p>
        </div>
      </div>
      <div class="rounded-card border hairline bg-white/90 p-8 backdrop-blur sm:p-10" data-reveal style="--d:120ms">
        <h3 class="font-sans text-sm font-bold uppercase tracking-[0.22em] text-gold-deep">In addition, the program supports:</h3>
        <ul class="dot-list-lg mt-7 space-y-4 text-[1.05rem] text-ink">
          {supports.map((s, i) => <li data-reveal style={`--d:${200 + i * 60}ms`}>{s}</li>)}
        </ul>
        <p class="mt-7 text-xs text-muted">Individual results vary.</p>
      </div>
    </div>
  </section>

  <!-- A day on the cleanse (white) -->
  <section class="py-24 sm:py-32" aria-labelledby="ritual-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow mb-5">One clear rhythm</p>
          <h2 id="ritual-h" class="display-lg">A day on the <em>cleanse.</em></h2>
        </div>
        <a href="/how-it-works#rhythm" class="link-arrow">See the full routine <span aria-hidden="true">→</span></a>
      </div>
      <ol class="mt-14 grid gap-6 md:grid-cols-3">
        {ritual.map((r, i) => (
          <li class="group" data-reveal style={`--d:${i * 120}ms`}>
            <a href="/how-it-works#rhythm" class="block">
              <ImageSlot name={r.img} alt={r.alt} class="zoom-img aspect-[4/5] rounded-card bg-paper" sizes="(min-width: 768px) 380px, 100vw" />
              <div class="mt-5 flex items-baseline gap-4">
                <span class="font-serif text-3xl font-bold text-gold-deep">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="text-[0.78rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">{r.when}</p>
                  <p class="mt-1 text-ink-soft">{r.line}</p>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Quote interlude (full-bleed photo) -->
  <section class="relative isolate overflow-hidden" aria-label="Our philosophy">
    <div class="absolute inset-0 -z-10"><ImageSlot name={['after-reset', 'ritual-terrace', 'hiw-evening']} alt="" class="breathe h-full w-full" imgClass="h-full w-full object-cover object-[70%_40%]" sizes="100vw" /></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/75 via-ink/45 to-ink/10"></div>
    <div class="wrap py-32 sm:py-44">
      <blockquote class="max-w-2xl" data-reveal>
        <p class="font-serif text-[clamp(2rem,4.2vw,3.4rem)] leading-[1.12] font-semibold text-white italic">“The value of the program lies not in extremes, but in structure, consistency, and intention.”</p>
        <footer class="mt-8 text-xs font-semibold tracking-[0.3em] text-honey uppercase">The Lemon Detox Cleanse</footer>
      </blockquote>
    </div>
  </section>

  <!-- Programs (white) -->
  <section id="programs" class="pt-24 pb-16 sm:pt-32" aria-labelledby="programs-h">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <h2 id="programs-h" class="display-lg">Select your <em>program.</em></h2>
        <a href={site.guidePdf} target="_blank" rel="noopener" class="link-arrow mt-5 text-sm">Learn how it works <span aria-hidden="true">→</span></a>
      </div>
      <div class="mx-auto mt-14 grid max-w-4xl gap-6 md:grid-cols-2 lg:gap-8">
        {products.map((p, i) => <ProductCard product={p} delay={i * 120} />)}
      </div>
      <TrustRow class="mt-10" center />
    </div>
  </section>

  <GuideRequest />

  <!-- Testimonials (#faf9f6) -->
  <section class="texture bg-paper py-24 sm:py-32" aria-labelledby="voices-h">
    <div class="wrap">
      <div class="text-center" data-reveal>
        <p class="font-serif text-2xl font-semibold text-gold-deep italic">Trusted for decades.</p>
        <h2 id="voices-h" class="display-lg mt-2">Everyday People. Real Stories.</h2>
      </div>
      <div id="voices" class="-mx-5 mt-14 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 [scrollbar-width:none] lg:mx-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-0" aria-label="Customer quotes" tabindex="0" role="region">
        {homeCards.map((c, i) => {
          const img = photoFor(c.photo);
          return (
            <figure class="lift flex w-[80%] shrink-0 snap-center flex-col items-center rounded-card border hairline bg-white px-6 pt-8 pb-7 text-center sm:w-[46%] lg:w-auto" data-reveal style={`--d:${i * 90}ms`}>
              {img ? <Picture src={img} alt={`Portrait of ${c.name}`} formats={['avif', 'webp']} widths={[120, 240]} sizes="120px" class="h-28 w-28 rounded-full object-cover object-top ring-4 ring-lemon-pale" /> : <span class="grid h-28 w-28 place-items-center rounded-full bg-lemon-pale font-serif text-3xl text-gold-deep">{c.name[0]}</span>}
              <span class="-mt-4 grid h-8 w-8 place-items-center rounded-full border hairline bg-white font-serif text-xl leading-none text-gold" aria-hidden="true">“</span>
              <blockquote class="mt-4 flex-1 font-serif text-[1.3rem] leading-snug font-medium text-ink">“{c.quote}”</blockquote>
              <figcaption class="mt-6">
                <span class="block text-[0.95rem] font-semibold text-ink">{c.name}</span>
                {c.role && <span class="block text-xs tracking-[0.15em] text-muted uppercase">{c.role}</span>}
                <span class="mt-0.5 block text-xs tracking-[0.15em] text-muted uppercase">{c.location}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>
      <div class="mt-12 text-center">
        <a href="/testimonials" class="btn btn-secondary btn-caps">Read more testimonials</a>
        <p class="mt-6 text-xs text-muted">Individual results vary.</p>
      </div>
    </div>
  </section>

  <CTA />

  <script>
    // Gentle auto-slide on small screens (every 7s). Pauses on hover, focus or touch; off for reduced motion.
    const track = document.getElementById('voices');
    if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let paused = false;
      ['mouseenter', 'focusin', 'touchstart'].forEach((ev) => track.addEventListener(ev, () => (paused = true), { passive: true }));
      ['mouseleave', 'focusout'].forEach((ev) => track.addEventListener(ev, () => (paused = false)));
      setInterval(() => {
        if (paused || track.scrollWidth <= track.clientWidth + 4) return;
        const card = track.children[0] as HTMLElement;
        const step = card.offsetWidth + 20;
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
        track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + step, behavior: 'smooth' });
      }, 7000);
    }
  </script>
</Base>
