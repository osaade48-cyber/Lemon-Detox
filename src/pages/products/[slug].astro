---
import Base from '../../layouts/Base.astro';
import ResetBox from '../../components/ResetBox.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import LemonSlice from '../../components/LemonSlice.astro';
import BuyButton from '../../components/BuyButton.astro';
import PriceNote from '../../components/PriceNote.astro';
import TrustRow from '../../components/TrustRow.astro';
import Accordion from '../../components/Accordion.astro';
import StoryCard from '../../components/StoryCard.astro';
import CTA from '../../components/CTA.astro';
import { products, type Product } from '../../data/products';
import { byName } from '../../data/testimonials';
import { site } from '../../config/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props as { product: Product };
const other = products.find((x) => x.slug !== p.slug)!;
const stories = byName(p.days === 7 ? ['A. Drake', 'Barb Evans', 'Leanne Pizzi'] : ['Ganna Sikalo', 'Daniel Martez', 'Hava Huner']);
const label = p.name.replace(/^\d+-Day /, '');
const s = site.shipping;

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.body,
  brand: { '@type': 'Brand', name: site.name },
  image: new URL('/og.png', site.url).href,
  url: new URL(`/products/${p.slug}`, site.url).href,
  offers: {
    '@type': 'Offer',
    price: p.price.toFixed(2),
    priceCurrency: 'AUD',
    availability: p.checkoutUrl ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    url: new URL(`/products/${p.slug}`, site.url).href,
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'AUD' },
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'AU' },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'AU',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 14,
    },
  },
}];
---
<Base title={p.seoTitle} description={p.seoDescription} jsonLd={jsonLd} shopBar={{ text: `${p.name} · $${p.price}`, href: p.checkoutUrl, label: 'Add to cart' }}>
  <nav aria-label="Breadcrumb" class="wrap pt-8 text-sm text-muted">
    <ol class="flex flex-wrap gap-2"><li><a href="/" class="hover:text-ink">Home</a></li><li aria-hidden="true">/</li><li><a href="/#programs" class="hover:text-ink">Programs</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-ink">{p.name}</li></ol>
  </nav>

  <!-- Product hero -->
  <section class="wrap grid gap-10 pt-8 pb-24 lg:grid-cols-2 lg:gap-16" data-hero>
    <div class="relative lg:sticky lg:top-28 lg:self-start">
      <ImageSlot name={`product-${p.days}day`} alt={`The ${p.name} Reset Box`} eager class:list={['aspect-square rounded-card', p.badge ? 'bg-honey/45' : 'bg-lemon-pale/55']} sizes="(min-width: 1024px) 580px, 100vw">
        <LemonSlice class="absolute -top-20 -right-20 h-72 w-72 opacity-70" spin />
        <LemonSlice class="absolute -bottom-10 -left-10 h-40 w-40 opacity-50" />
        <ResetBox days={p.days} label={label} class="relative mx-auto h-full w-auto p-10 drop-shadow-[0_30px_40px_rgba(138,100,24,0.2)]" />
      </ImageSlot>
      {p.badge && <span class="absolute top-6 left-6 rounded-full bg-ink px-4 py-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-cream">{p.badge}</span>}
    </div>

    <div class="lg:pt-6">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="display-lg mt-4">{p.name}</h1>
      <div class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="font-serif text-5xl text-ink">${p.price}</span>
        <span class="font-semibold text-muted">AUD</span>
        <span class="text-muted">· Free tracked shipping</span>
      </div>
      <p class="lead mt-6">{p.body}</p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <BuyButton href={p.checkoutUrl} product={p.name} class="min-w-[14rem]" />
        <a href="/how-it-works" class="link-arrow text-sm">How it works</a>
      </div>
      <PriceNote class="mt-4" />

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <div class="card p-6">
          <h2 class="eyebrow">In the box</h2>
          <ul class="check-list mt-4 space-y-2.5 text-[0.95rem]">{p.inTheBox.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="card p-6">
          <h2 class="eyebrow">You'll also need</h2>
          <ul class="dot-list mt-4 space-y-2.5 text-[0.95rem]">
            <li>Fresh lemons (about {p.lemons})</li><li>Cayenne pepper</li><li>Water</li>
          </ul>
        </div>
      </div>

      <TrustRow class="mt-8 border-t hairline pt-6" />

      <div class="mt-8">
        <Accordion q="Shipping">
          <p>Free tracked standard shipping on every order within Australia.{s.dispatchDays && ` Orders are dispatched within ${s.dispatchDays} business day${s.dispatchDays === '1' ? '' : 's'}.`}{s.expressPrice && ` Express shipping is available at checkout for ${s.expressPrice}.`} <a href="/shipping">Shipping &amp; delivery</a></p>
        </Accordion>
        <Accordion q="Returns">
          <p>Unopened boxes can be returned within 14 days. <a href="/returns">Returns &amp; refunds</a></p>
        </Accordion>
        <Accordion q="Who it isn't for">
          <p>The Lemon Detox Cleanse is not suitable if you are pregnant or breastfeeding; under 18; living with diabetes, heart, kidney or liver disease, or high or low blood pressure; recovering from surgery or illness; living with, or have a history of, an eating disorder; or taking prescription medication (check with your doctor first). <a href="/how-it-works#who-it-isnt-for">Read more</a></p>
        </Accordion>
      </div>
    </div>
  </section>

  <!-- Why this length -->
  <section class="bg-paper py-24 sm:py-32" aria-labelledby="why-h">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <p class="eyebrow mb-5">{p.eyebrow}</p>
        <h2 id="why-h" class="display-lg">{p.whyTitle.replace(/ days$/, '')} <em>days.</em></h2>
        {p.body2 && <p class="lead mt-8">{p.body2}</p>}
      </div>
      <ol class="border-t hairline" data-reveal style="--d:100ms">
        {p.why.map((w, i) => (
          <li class="flex items-baseline gap-6 border-b hairline py-6">
            <span class="w-8 shrink-0 font-serif text-xl text-gold-deep">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-serif text-[1.65rem] leading-tight text-ink sm:text-3xl">{w}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Three ways summary -->
  <section class="py-24 sm:py-32" aria-labelledby="ways-h">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow mb-5">Three ways to follow it</p>
          <h2 id="ways-h" class="display-lg">How long your box <em>lasts.</em></h2>
        </div>
        <a href="/how-it-works#three-ways" class="link-arrow">Compare the three ways</a>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {[
          ['Full Cleanse', 'Deepest reset', 'Every meal is replaced with the Lemon Detox drink.', p.boxLasts.full],
          ['Relaxed', 'Most flexible', 'Breakfast and dinner are replaced; lunch is a light, healthy meal.', p.boxLasts.relaxed],
          ['50/50', 'Ease in, ease out', 'Relaxed, then Full Cleanse, then Relaxed again.', p.boxLasts.fiftyFifty],
        ].map(([n, b, d, l], i) => (
          <article class="card p-7" data-reveal style={`--d:${i * 90}ms`}>
            <p class="eyebrow">{b}</p>
            <h3 class="mt-3 text-3xl">{n}</h3>
            <p class="mt-2 text-ink-soft">{d}</p>
            <p class="mt-6 border-t hairline pt-5 font-serif text-4xl text-ink">{l}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories -->
  {stories.length > 0 && (
    <section class="bg-paper py-24 sm:py-32" aria-labelledby="st-h">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <div><p class="eyebrow mb-5">Stories from the cleanse</p><h2 id="st-h" class="display-lg">Real people. <em>Real resets.</em></h2></div>
          <a href="/stories" class="btn btn-secondary">Read all stories</a>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">{stories.map((t, i) => <StoryCard t={t} full delay={i * 90} />)}</div>
        <p class="mt-8 text-sm text-muted">Individual results vary.</p>
      </div>
    </section>
  )}

  <!-- Other program -->
  <section class="py-20" aria-label="Other program">
    <div class="wrap">
      <a href={`/products/${other.slug}`} class="card card-hover flex flex-col items-start justify-between gap-6 p-8 sm:flex-row sm:items-center sm:p-10">
        <div>
          <p class="eyebrow">Also available</p>
          <p class="mt-3 font-serif text-4xl text-ink">{other.name} · ${other.price}</p>
          <p class="mt-2 text-ink-soft">{other.cardLine}</p>
        </div>
        <span class="btn btn-secondary">View details</span>
      </a>
    </div>
  </section>

  <CTA title="Begin your <em>reset.</em>" body="A simple, structured plan that resets your relationship with food." />
</Base>
