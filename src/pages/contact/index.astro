---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';

const formspree = site.forms.FORMSPREE_ENDPOINT;
const success = "Thanks — we've got your message and will be in touch within one business day.";
const field = 'mt-2 block w-full rounded-[10px] border border-black/10 bg-paper px-4 py-3.5 text-ink placeholder:text-muted/70 transition focus:border-ink focus:outline-none focus:ring-2 focus:ring-honey/60';
const contact = [site.email && ['Email', site.email, `mailto:${site.email}`], site.phone && ['Phone', site.phone, `tel:${site.phone.replace(/\s/g, '')}`]].filter(Boolean) as string[][];
---
<Base title="Contact — Lemon Detox Cleanse" description="Questions about your order or the program? Get in touch.">
  <section class="relative overflow-hidden" data-hero>
    <div class="wrap relative grid gap-14 pt-16 pb-28 sm:pt-24 lg:grid-cols-[1fr_1.15fr] lg:gap-24">
      <div>
        <span class="chip">Contact</span>
        <h1 class="display-xl mt-6 !text-[clamp(3rem,7vw,6rem)]">We're here to <em>help.</em></h1>
      <span class="rule" aria-hidden="true"></span>
        <p class="lead mt-8 max-w-md">Questions about the program or your order? Send us a message and we'll reply within one business day.</p>
        {contact.length > 0 && (
          <dl class="mt-10 space-y-4">{contact.map(([k, v, h]) => <div><dt class="eyebrow">{k}</dt><dd class="mt-1"><a href={h} class="text-lg text-ink hover:text-gold-deep">{v}</a></dd></div>)}</dl>
        )}
        {site.address && <p class="mt-4 text-ink-soft">{site.address}</p>}
        <div class="mt-12 hidden border-t hairline pt-8 lg:block">
          <p class="text-ink-soft">Looking for a quick answer?</p>
          <a href="/faqs" class="link-arrow mt-2">Browse the FAQs</a>
        </div>
      </div>

      <div class="card relative p-7 sm:p-10">
        <form
          id="contact-form"
          name="contact"
          method="POST"
          action={formspree || '/contact/thanks/'}
          {...(!formspree ? { 'data-netlify': 'true', 'netlify-honeypot': 'company' } : {})}
          class="grid gap-5 sm:grid-cols-2"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>

          <label class="text-sm font-semibold text-ink">Name<input name="name" required autocomplete="name" class={field} /></label>
          <label class="text-sm font-semibold text-ink">Email<input name="email" type="email" required autocomplete="email" class={field} /></label>
          <label class="text-sm font-semibold text-ink">Order number <span class="font-normal text-muted">(optional)</span><input name="order" class={field} /></label>
          <label class="text-sm font-semibold text-ink">Topic
            <select name="topic" id="topic" required class={field}>
              <option value="Order">Order</option>
              <option value="Program question">Program question</option>
              <option value="Becoming a stockist">Becoming a stockist</option>
              <option value="Other">Other</option>
            </select>
          </label>
          <label class="text-sm font-semibold text-ink sm:col-span-2">Message<textarea name="message" required rows="6" class={field}></textarea></label>
          <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
            <button type="submit" class="btn btn-primary">Send message</button>
            <p id="form-error" class="hidden text-sm text-[#9b2c1c]" role="alert">Sorry — something went wrong. Please try again in a moment.</p>
          </div>
        </form>
        <div id="form-success" class="hidden py-10 text-center" role="status" tabindex="-1">
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-lemon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22"><path d="M5 11.5l4 4 8-9" fill="none" stroke="#1A1A1A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <p class="mx-auto mt-6 max-w-sm font-serif text-3xl leading-snug text-ink">{success}</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const ok = document.getElementById('form-success')!;
    const err = document.getElementById('form-error')!;
    const topic = document.getElementById('topic') as HTMLSelectElement;
    if (new URLSearchParams(location.search).get('topic') === 'stockist') topic.value = 'Becoming a stockist';
    if (new URLSearchParams(location.search).get('topic') === 'story') {
      topic.value = 'Other';
      (form.elements.namedItem('message') as HTMLTextAreaElement).placeholder = 'Tell us how your cleanse went…';
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      const data = new FormData(form);
      const isFormspree = form.action.includes('formspree');
      try {
        const res = await fetch(isFormspree ? form.action : '/', {
          method: 'POST',
          headers: isFormspree ? { Accept: 'application/json' } : { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: isFormspree ? data : new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('hidden');
        ok.classList.remove('hidden');
        ok.focus();
      } catch {
        err.classList.remove('hidden');
      }
    });
  </script>
</Base>
