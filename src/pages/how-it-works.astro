---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import ImageSlot from '../components/ImageSlot.astro';
import dropIcon from '../assets/water-drop-icon.png';

const nav = [
  ['program', 'The Program'],
  ['pause', 'The Pause'],
  ['rhythm', 'Daily Rhythm'],
  ['formula', 'The Formula'],
  ['mixing', 'Mixing'],
  ['elimination', 'Elimination'],
  ['versions', 'Versions'],
  ['depth', 'Depth'],
  ['expect', 'What to Expect'],
  ['who-it-isnt-for', 'Before You Start'],
];

const icons = {
  morning: 'M3 17h18M6.5 17a5.5 5.5 0 0 1 11 0M12 5v3M4.2 9.2l2 2M19.8 9.2l-2 2M2 13h2M20 13h2',
  day: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4',
  evening: 'M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5zM17 3l.6 1.4L19 5l-1.4.6L17 7l-.6-1.4L15 5l1.4-.6z',
};

const day = [
  {
    key: 'morning', when: 'Morning', title: 'The elimination routine.', img: 'hiw-morning',
    alt: 'A sunny terrace table set with a jug of the Lemon Detox drink, lemons, sea salt, a cup of tea and the Madal Bal tin',
    body: [
      'The day typically begins with the elimination routine.',
      'This involves drinking the <strong>sea salt water mixture</strong> or, alternatively, a cup of <strong>herbal laxative tea</strong>. This step helps stimulate the body’s elimination process and assists in clearing the digestive tract.',
      'The Lemon Detox drink can be made fresh in the morning or prepared the night before if more convenient. The full daily batch can be taken with you to work if necessary.',
    ],
  },
  {
    key: 'day', when: 'Through the day', title: 'Drink it gradually and consistently.', img: 'hiw-day',
    alt: 'A woman in a white top sipping the Lemon Detox drink beside a jug and fresh lemons',
    body: [
      'The Lemon Detox drink is consumed regularly throughout the day.',
      'The mixture provides <strong>liquid nourishment</strong> and helps sustain energy while giving the digestive system a temporary break from processing solid food.',
      'Additional water is also consumed throughout the day to help the elimination process.',
    ],
  },
  {
    key: 'evening', when: 'Evening', title: 'Senna tea, then rest.', img: 'hiw-evening',
    alt: 'A woman relaxing in the evening light with a glass of the Lemon Detox drink and a bowl of lemons',
    body: [
      'Once the daily Lemon Detox drink mixture has been consumed, a cup of <strong>herbal laxative tea</strong> is taken before bed. This helps support the body’s elimination process during the cleanse.',
      'Adequate rest is encouraged during the program while the body continues its natural cleansing and restorative processes overnight.',
    ],
  },
] as const;

const ingredients = [
  { img: 'ing-syrup', alt: 'Natural tree syrup being poured into a small glass', name: 'Madal Bal® Natural Tree Syrup', body: 'The key ingredient, a balanced blend of Canadian Grade C maple syrup and the purest Palm syrups providing energy in the form of easily digestible carbohydrates and a high level of potassium.', fit: 'cover' },
  { img: 'ing-lemon', alt: 'A hand squeezing a fresh lemon into a small glass', name: 'Fresh Lemon Juice', body: 'Freshly squeezed lemons provide vitamin C and citrus polyphenols. Traditionally valued for their cleansing properties, a refreshing flavour while supporting the body’s own detoxification pathways.', fit: 'cover' },
  { img: 'ing-cayenne', alt: 'Ground cayenne pepper on a wooden spoon beside dried chillies', name: 'Cayenne Pepper', body: 'Helps stimulate circulation and support metabolism during the cleanse, while also adding a pleasant warmth to the drink.', fit: 'cover' },
  { img: 'ing-water', alt: 'Pure water being poured into a glass', name: 'Pure Water', body: 'Clean, pure water helps carry the formula through the body while maintaining hydration during the cleanse and supporting the body’s natural cleansing processes.', fit: 'cover', icon: true },
];

const versions = [
  {
    img: 'way-full', alt: 'A woman sitting by the pool with a glass of the Lemon Detox drink',
    name: 'Full Body Cleanse', tag: 'All meals replaced',
    body: 'In this version, all meals are replaced with the Lemon Detox drink, allowing the body to remain in a continuous cleansing state.',
    meals: [['Breakfast', '2–3 glasses'], ['Lunch', '2–3 glasses'], ['Dinner', '2–3 glasses']],
    note: 'This version can be followed for a minimum of 7 days, although 10–14 days is considered the ideal duration.',
  },
  {
    img: 'way-relaxed', alt: 'A couple sharing a light, healthy lunch alongside glasses of the Lemon Detox drink',
    name: 'Relaxed Version', tag: 'One healthy meal per day',
    body: 'A more flexible approach that allows the cleanse to fit around everyday routines. Breakfast and dinner are replaced with the Lemon Detox drink, while a healthy meal is eaten at lunch.',
    meals: [['Breakfast', '2–3 glasses'], ['Lunch', 'Healthy meal'], ['Dinner', '2–3 glasses']],
    note: 'This version is typically followed for at least two weeks and provides a gentler approach to the Lemon Detox program while still supporting the body’s natural cleansing processes.',
  },
  {
    img: 'way-5050', alt: 'A smiling woman holding a glass of the Lemon Detox drink at an outdoor café',
    name: '50/50 Version', tag: 'Gradual transition',
    body: 'This version combines the Relaxed Version and the Full Body Cleanse, allowing the body to gradually transition into the full cleanse. Makes it easier to fit around social or work commitments.',
    meals: [['Days 1–3', 'Relaxed Version'], ['Days 4–6', 'Full Body Cleanse'], ['Days 7–9', 'Relaxed Version']],
    note: 'Total program duration: 9 days if purchasing the 7 Day Pack. 18 days if purchasing the 14 Day Pack.',
  },
];
---
<Base title="How It Works — Lemon Detox Cleanse" description="The daily routine, the Lemon Detox drink, mixing instructions, elimination support and the three ways to follow the Lemon Detox Cleanse.">
  <!-- Section 1: The Program -->
  <section id="program" class="scroll-mt-40" data-hero aria-labelledby="program-h">
    <div class="wrap grid items-center gap-12 pt-14 pb-20 lg:grid-cols-[1.1fr_1fr] lg:gap-20 lg:pt-20 lg:pb-28">
      <div>
        <span class="chip">The program</span>
        <h1 id="program-h" class="display-xl mt-6 !text-[clamp(2.75rem,5.6vw,4.75rem)]">How the Lemon Detox Cleanse <em>works.</em></h1>
        <div class="my-8 flex items-center gap-0" aria-hidden="true"><span class="h-px w-14 bg-gradient-to-r from-transparent to-gold"></span><span class="h-2 w-2 rounded-full bg-gold"></span><span class="h-px w-14 bg-gradient-to-l from-transparent to-gold"></span></div>
        <div class="max-w-xl space-y-5 text-ink-soft">
          <p>The Lemon Detox Cleanse is undertaken over a defined 7 or up to 14 day timeframe. During this period, solid food is temporarily removed and replaced with a simple liquid routine centred around the Lemon Detox drink.</p>
          <p>The program is designed to simplify intake and create a deliberate pause from constant consumption. Temporarily abstaining from solid food allows the body to rest from constant digestion and re-establish its natural cleansing and metabolic balance.</p>
        </div>
        <p class="mt-8 text-sm text-muted">Prefer to start now? <a href="/#programs" class="link-arrow ml-1">View Programs <span aria-hidden="true">→</span></a></p>
      </div>
      <div class="relative">
        <ImageSlot name="hiw-hero" alt="A glass jug of the Lemon Detox drink with fresh lemons" eager class="zoom-img breathe aspect-[4/5] rounded-card bg-paper" sizes="(min-width: 1024px) 520px, 100vw" />
        <div class="absolute -bottom-6 left-6 rounded-card bg-white px-6 py-4 shadow-[var(--shadow-soft)] sm:left-auto sm:-right-6">
          <p class="font-serif text-2xl text-ink">7 to 14 days</p>
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-gold-deep">One clear rhythm</p>
        </div>
      </div>
    </div>
  </section>

  <!-- In-page menu -->
  <nav aria-label="On this page" class="sticky top-[4.75rem] z-20 border-y hairline bg-white/95 backdrop-blur">
    <ul class="wrap flex gap-7 overflow-x-auto py-3.5 text-[0.7rem] font-semibold tracking-[0.16em] whitespace-nowrap uppercase [scrollbar-width:none] lg:justify-center">
      {nav.map(([id, l]) => <li><a href={`#${id}`} class="border-b border-transparent pb-1 text-muted transition hover:text-ink" data-toc={id}>{l}</a></li>)}
    </ul>
  </nav>

  <!-- Section 2: The Pause (off-white) -->
  <section id="pause" class="scroll-mt-36 bg-paper/70 py-16 lg:py-24" aria-labelledby="pause-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-20">
      <div data-reveal>
        <span class="chip mb-6">The pause</span>
        <h2 id="pause-h" class="display-lg">Why choose the Lemon Detox <em>Cleanse.</em></h2>
          <span class="rule" aria-hidden="true"></span>
      </div>
      <div class="space-y-5 text-ink-soft" data-reveal style="--d:100ms">
        <p>Modern life is fast, demanding, and often excessive. Convenience foods, constant snacking, and busy schedules can leave little space for awareness or balance.</p>
        <p>The body is designed to regulate and maintain itself. However, when routines become overloaded, many people feel out of rhythm — heavier, less focused, and lacking clarity.</p>
        <p>The Lemon Detox Cleanse provides a structured pause. By temporarily replacing solid food with a simple liquid routine, the program reduces digestive demand and creates space for recalibration.</p>
        <p>By simplifying intake and removing decision fatigue around food, many participants experience weight loss, improved awareness, and renewed control over their habits.</p>
        <p class="border-l-2 border-gold pl-6 font-serif text-2xl leading-snug text-ink italic">The value of the program lies not in extremes, but in structure, consistency, and intention.</p>
      </div>
    </div>
  </section>

  <!-- Section 3: Daily rhythm (white) -->
  <section id="rhythm" class="scroll-mt-36 py-16 lg:py-24" aria-labelledby="rhythm-h">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <span class="chip mb-6">Daily rhythm</span>
        <h2 id="rhythm-h" class="display-lg">A typical day on the Lemon Detox <em>Cleanse.</em></h2>
          <span class="rule" aria-hidden="true"></span>
        <p class="mt-6 text-ink-soft">The program follows a simple daily rhythm designed to support detoxification, elimination, and the required energy throughout the cleanse.</p>
      </div>
      <div class="mt-16 space-y-12 sm:space-y-16">
        {day.map((d, i) => (
          <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16" data-reveal>
            <ImageSlot name={d.img} alt={d.alt} class:list={['zoom-img aspect-[4/3] rounded-card bg-paper', i % 2 === 1 && 'lg:order-2']} sizes="(min-width: 1024px) 560px, 100vw" data-unveil />
            <div>
              <div class="flex items-center gap-4">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-lemon-pale text-gold-deep"><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[d.key]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <p class="text-[0.8rem] font-semibold uppercase tracking-[0.18em] text-gold-deep">{d.when}</p>
              </div>
              <h3 class="mt-5 text-3xl sm:text-[2.4rem]">{d.title}</h3>
              <div class="mt-4 space-y-4 text-[0.98rem] text-ink-soft">{d.body.map((b) => <p set:html={b} />)}</div>
              {d.key === 'evening' && <p class="mt-6 border-t hairline pt-5 text-ink-soft italic">The routine quickly becomes simple and repetitive — leaving you free to focus on rest, hydration, and the cleanse itself.</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: The Formula (off-white) -->
  <section id="formula" class="scroll-mt-36 bg-paper/70 py-16 lg:py-24" aria-labelledby="formula-h">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-20" data-reveal>
        <div>
          <span class="chip mb-6">The formula</span>
          <h2 id="formula-h" class="display-lg">What is the Lemon Detox <em>drink?</em></h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="space-y-5 text-ink-soft">
          <p>The Lemon Detox program centres around a simple drink made from the <strong class="text-ink">Madal Bal® Natural Tree Syrup</strong>, fresh lemon juice, cayenne pepper and pure water.</p>
          <p>During the cleanse, this drink replaces regular meals while supplying your body with natural carbohydrates, minerals and hydration. The digestive system rests — yet you remain energised throughout the day. Simple liquid nourishment!</p>
          <p>By temporarily replacing solid food with simple liquid nourishment, the body can redirect energy normally used for digestion toward its natural cleansing and restorative processes.</p>
        </div>
      </div>
      <h3 class="mt-16 font-sans text-sm font-bold uppercase tracking-[0.22em] text-gold-deep">The four key ingredients</h3>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ingredients.map((g, i) => (
          <article class="lift flex flex-col overflow-hidden card" data-reveal style={`--d:${i * 80}ms`}>
            <ImageSlot name={g.img} alt={g.alt} class:list={['zoom-img aspect-[4/3]', g.fit === 'contain' ? 'bg-white' : 'bg-paper']} imgClass={g.fit === 'contain' ? 'h-full w-full object-contain p-6' : 'h-full w-full object-cover'} sizes="(min-width: 1024px) 280px, 50vw" />
            <div class="relative flex-1 p-[30px]">
              {g.icon && <Image src={dropIcon} alt="" width={56} height={56} class="absolute -top-7 right-6 h-14 w-14 rounded-full shadow-sm" />}
              <h4 class="font-sans text-[1.25rem] font-semibold leading-snug text-ink">{g.name}</h4>
              <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{g.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Mixing (white) -->
  <section id="mixing" class="scroll-mt-36 py-16 lg:py-24" aria-labelledby="mix-h">
    <div class="wrap">
      <div class="grid items-end gap-6 lg:grid-cols-[1fr_1.1fr] lg:gap-20" data-reveal>
        <div>
          <span class="chip mb-6">Lemon Detox drink</span>
          <h2 id="mix-h" class="display-lg">Daily mixing <em>instructions.</em></h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <p class="text-ink-soft lg:pb-2">The Lemon Detox drink is simple, natural and easy to prepare. Fresh ingredients give the best flavour and the most effective cleanse experience.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {[
          { t: 'For a 2 litre batch', sub: 'Preferred for the whole day', rec: true, items: ['140 ml Madal Bal® Natural Tree Syrup', '3½ freshly squeezed lemons (approximately 140 ml juice)', '2–3 pinches of cayenne pepper', 'Approximately 1700 ml fresh or filtered water'] },
          { t: 'Per glass', sub: 'Handy when travelling', items: ['1 tablespoon (20 ml) Madal Bal® Natural Tree Syrup', '1 tablespoon freshly squeezed lemon juice (about half a lemon)', '½ pinch cayenne pepper (adjust to taste)', 'At least 250 ml fresh or filtered water'] },
        ].map((m, i) => (
          <div class:list={['card p-7 sm:p-9', m.rec && '!border-gold/40']} data-reveal style={`--d:${i * 90}ms`}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-[2rem]">{m.t}</h3>
              {m.rec && <span class="rounded-full bg-honey px-3 py-1 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-ink">Recommended</span>}
            </div>
            <p class="mt-1 text-sm text-muted">{m.sub}</p>
            <ol class="mt-6 divide-y divide-black/[0.07]">
              {m.items.map((it, j) => <li class="flex gap-5 py-3.5"><span class="font-serif text-xl text-gold-deep">{String(j + 1).padStart(2, '0')}</span><span>{it}</span></li>)}
            </ol>
          </div>
        ))}
      </div>
      <ul class="mt-8 flex flex-wrap gap-3 text-sm" data-reveal>
        {['Mix well before drinking.', 'Enjoy cold, at room temperature, or warm.', 'After opening, keep the Madal Bal tin refrigerated.'].map((n) => <li class="rounded-full border hairline bg-white px-4 py-2 text-ink-soft">{n}</li>)}
      </ul>
    </div>
  </section>

  <!-- Section 6: Elimination (off-white) -->
  <section id="elimination" class="scroll-mt-36 bg-paper/70 py-16 lg:py-24" aria-labelledby="elim-h">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-20" data-reveal>
        <div>
          <span class="chip mb-6">Elimination</span>
          <h2 id="elim-h" class="display-lg">The key to a successful <em>program.</em></h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="space-y-5 text-ink-soft">
          <p><strong class="text-ink">Effective elimination</strong> is the key to a successful Lemon Detox program, helping the body remove waste products released during the cleanse.</p>
          <p><strong class="text-ink">Sea Salt and Senna Tea are provided</strong> to help stimulate the body’s natural elimination process during the cleanse.</p>
        </div>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <article class="lift overflow-hidden card" data-reveal>
          <ImageSlot name={['sea-salt', 'hiw-morning']} alt="Morning light on a terrace table with the Lemon Detox drink and sea salt" class="zoom-img aspect-[16/8] bg-paper" sizes="(min-width: 768px) 580px, 100vw" />
          <div class="flex items-center gap-5 px-7 pt-7">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-lemon/20 text-gold-deep"><svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.morning} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <h3 class="font-sans text-lg font-bold uppercase tracking-[0.14em] text-ink">Morning – Sea Salt Water</h3>
          </div>
          <p class="px-7 pt-4 pb-7 text-ink-soft">The sea salt water drink is prepared by dissolving <strong class="text-ink">two teaspoons of natural, uniodised sea salt</strong> in <strong class="text-ink">one litre of warm purified water</strong> and drinking it <strong class="text-ink">on an empty stomach</strong>.</p>
        </article>
        <article class="lift overflow-hidden card" data-reveal style="--d:90ms">
          <ImageSlot name={['senna-leaves', 'senna-tea']} alt="A bowl of dried senna leaves on linen" class="zoom-img aspect-[16/8] bg-paper" sizes="(min-width: 768px) 580px, 100vw" />
          <div class="flex items-center gap-5 px-7 pt-7">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-lemon/20 text-gold-deep"><svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.evening} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <h3 class="font-sans text-lg font-bold uppercase tracking-[0.14em] text-ink">Evening – Herbal Senna Tea</h3>
          </div>
          <p class="px-7 pt-4 pb-7 text-ink-soft"><strong class="text-ink">Senna tea</strong>, a mild herbal laxative <strong class="text-ink">taken before bed</strong>, supports overnight elimination of waste released during the cleanse.</p>
        </article>
      </div>
      <div class="mt-10 grid gap-5 text-ink-soft md:grid-cols-2" data-reveal>
        <p>In addition to the Lemon Detox drink, it is recommended to drink <strong class="text-ink">1–2 litres of fresh water each day</strong> to help support the body’s natural cleansing processes.</p>
        <p>Practices such as <strong class="text-ink">dry skin brushing</strong> and <strong class="text-ink">light exercise</strong> may also complement the program by supporting circulation and overall wellbeing.</p>
      </div>
    </div>
  </section>

  <!-- Section 7: Versions (white) -->
  <section id="versions" class="scroll-mt-36 py-16 lg:py-24" aria-labelledby="ver-h">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <span class="chip mb-6">Versions</span>
        <h2 id="ver-h" class="display-lg">Choose the cleanse that <em>suits you.</em></h2>
          <span class="rule" aria-hidden="true"></span>
        <p class="mt-5 text-ink-soft">Choose the version that best suits your lifestyle and experience level.</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {versions.map((v, i) => (
          <article class="lift flex flex-col overflow-hidden card" data-reveal style={`--d:${i * 90}ms`}>
            <ImageSlot name={v.img} alt={v.alt} class="zoom-img aspect-[4/3] bg-paper" sizes="(min-width: 1024px) 380px, 100vw" />
            <div class="flex flex-1 flex-col p-7">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold-deep">{v.tag}</p>
              <h3 class="mt-2 text-[2.1rem]">{v.name}</h3>
              <p class="mt-3 text-[0.95rem] text-ink-soft">{v.body}</p>
              <dl class="mt-6 divide-y divide-black/[0.07] border-y hairline text-sm">
                {v.meals.map(([k, val]) => <div class="flex justify-between gap-4 py-3"><dt class="font-semibold text-ink">{k}</dt><dd class="text-right text-ink-soft">{val}</dd></div>)}
              </dl>
              <p class="mt-5 text-sm text-muted">{v.note}</p>
            </div>
          </article>
        ))}
      </div>
      <a href="/#programs" class="mt-12 flex items-center justify-center gap-3 rounded-card bg-ink px-6 py-6 text-center text-sm font-bold tracking-[0.25em] text-white uppercase transition hover:bg-gold-deep" data-reveal>
        Start your cleanse today
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </section>

  <!-- Section 8: Depth (off-white) -->
  <section id="depth" class="scroll-mt-36 bg-paper/70 py-16 lg:py-24" aria-labelledby="depth-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-20">
      <div data-reveal>
        <span class="chip mb-6">Depth</span>
        <h2 id="depth-h" class="display-lg">Why the Full Body Cleanse provides the deepest <em>cleanse.</em></h2>
          <span class="rule" aria-hidden="true"></span>
      </div>
      <div class="space-y-5 text-ink-soft" data-reveal style="--d:100ms">
        <p>The most important part of any detox program is giving the digestive system a break from solid food.</p>
        <p>Some people worry about the idea of going without solid foods, but the Lemon Detox program is not a traditional fast. A true fast involves complete abstinence from food. The Lemon Detox program instead provides <strong class="text-ink">liquid nourishment</strong>, supplying energy while allowing the body to take a temporary break from digesting solid foods.</p>
        <p>Digesting food requires a significant amount of energy. When solid food is removed from the diet, the body can redirect some of this energy toward its natural cleansing and restorative processes.</p>
        <p>For this reason, the <strong class="text-ink">Full Body Cleanse</strong> version, where all meals are replaced with the Lemon Detox drink, provides the most complete cleansing experience.</p>
        <p>While the Relaxed Version allows one healthy meal per day and can still be beneficial, consuming solid food requires the body to continue digesting, which may reduce the depth of the cleanse.</p>
      </div>
    </div>
  </section>

  <!-- What to expect (white) -->
  <section id="expect" class="scroll-mt-36 py-16 lg:py-24" aria-labelledby="expect-h">
    <div class="wrap">
      <div class="grid items-end gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div class="max-w-3xl" data-reveal>
        <span class="chip mb-6">What to expect</span>
        <h2 id="expect-h" class="display-lg">What to expect during the <em>cleanse.</em></h2>
          <span class="rule" aria-hidden="true"></span>
        <p class="mt-5 text-ink-soft">Each person’s experience of the Lemon Detox Cleanse is unique, however many participants notice a similar pattern as their body adjusts to the program.</p>
      </div>
      <ImageSlot name="expect-side" alt="A woman walking through a garden carrying a yoga mat and a water bottle" class="zoom-img hidden aspect-[4/5] max-h-[26rem] rounded-card bg-paper lg:block" sizes="360px" data-unveil />
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {[
          ['The Adjustment Phase', 'During the first few days, the body begins adapting to a temporary break from solid foods. It is common to experience mild hunger, changes in appetite, or fluctuations in energy. Some people may also notice temporary symptoms such as mild headaches, fatigue, a coated tongue, changes in bowel movements or occasional irritability. These are generally short-term effects as the body adjusts.'],
          ['The Balance Phase', 'As the cleanse progresses, many participants report that hunger sensations begin to decrease and energy levels become more stable. Without the constant demands of digesting solid foods, the digestive system is able to rest while the body focuses on restoring balance.'],
          ['The Clarity Phase', 'By the later stages of the cleanse, many people describe feeling lighter, more mentally clear and more aware of their eating habits and lifestyle choices — an opportunity to pause from everyday habits and reconnect with a healthier, more balanced way of living.'],
        ].map(([t, b], i) => (
          <li class="card p-7" data-reveal style={`--d:${i * 90}ms`}>
            <span class="grid h-10 w-10 place-items-center rounded-full bg-lemon font-serif text-lg text-ink">{i + 1}</span>
            <h3 class="mt-5 text-[1.8rem]">{t}</h3>
            <p class="mt-3 text-[0.95rem] text-ink-soft">{b}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-muted">As with any program involving dietary change, individual experiences may vary depending on lifestyle, body composition and adherence to the program.</p>
    </div>
  </section>

  <!-- Before you start (safety) -->
  <section id="who-it-isnt-for" class="scroll-mt-36 pb-24 sm:pb-28" aria-labelledby="who-h">
    <div class="wrap">
      <div class="card p-8 sm:p-12" data-reveal>
        <span class="chip mb-6">Before you start</span>
        <h2 id="who-h" class="display-md">Who the cleanse <em>isn't for.</em></h2>
          <span class="rule" aria-hidden="true"></span>
        <p class="mt-6 font-semibold text-ink">The Lemon Detox Cleanse is not suitable if you are:</p>
        <ul class="dot-list mt-4 grid gap-x-10 gap-y-3 text-ink-soft md:grid-cols-2">
          <li>pregnant or breastfeeding</li>
          <li>under 18</li>
          <li>living with diabetes, heart, kidney or liver disease, or high or low blood pressure</li>
          <li>recovering from surgery or illness</li>
          <li>living with, or have a history of, an eating disorder</li>
          <li>taking prescription medication (check with your doctor first)</li>
        </ul>
        <p class="mt-8 border-t hairline pt-6 text-sm text-ink-soft">If you feel faint, dizzy, unwell or have heart palpitations at any stage, stop and eat normally, and seek medical advice if symptoms continue.</p>
      </div>
    </div>
  </section>

  <CTA title="Start your reset <em>today.</em>" />

  <script>
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
    const set = (id: string) => links.forEach((a) => {
      const on = a.dataset.toc === id;
      a.classList.toggle('!text-ink', on);
      a.classList.toggle('!border-gold', on);
      on ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current');
      if (on) { const ul = a.closest('ul')!; ul.scrollTo({ left: a.offsetLeft - ul.clientWidth / 2 + a.offsetWidth / 2, behavior: 'smooth' }); }
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set(e.target.id)), { rootMargin: '-35% 0px -60% 0px' });
    document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));
  </script>
</Base>
