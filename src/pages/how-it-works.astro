---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';

const nav = [
  ['program', 'Overview'],
  ['pause', 'Why'],
  ['rhythm', 'A typical day'],
  ['formula', 'The drink'],
  ['mixing', 'Mixing'],
  ['elimination', 'Elimination'],
  ['versions', 'Versions'],
  ['depth', 'Depth'],
  ['expect', 'What to expect'],
];
const ingIcons = [
  'M5 19c0-8 5-13 14-14-1 9-6 14-14 14zM5 19l7-7',
  'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM12 4v16M4 12h16M6.3 6.3l11.4 11.4M17.7 6.3 6.3 17.7',
  'M12 3c3 4 5 7 5 10a5 5 0 0 1-10 0c0-3 2-6 5-10z',
  'M12 3c3.5 4.5 6 8 6 11a6 6 0 0 1-12 0c0-3 2.5-6.5 6-11z',
];
const sq = '!rounded-none';

const icons = {
  morning: 'M3 17h18M6.5 17a5.5 5.5 0 0 1 11 0M12 5v3M4.2 9.2l2 2M19.8 9.2l-2 2M2 13h2M20 13h2',
  day: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4',
  evening: 'M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5zM17 3l.6 1.4L19 5l-1.4.6L17 7l-.6-1.4L15 5l1.4-.6z',
};

const day = [
  {
    key: 'morning', when: 'Morning', title: 'The elimination routine.', img: 'hiw-morning',
    alt: 'A sunny terrace table set with a jug of the Lemon Detox drink, lemons, sea salt, a cup of tea and the Madal Bal tin',
    body: [
      'The day typically begins with the elimination routine.',
      'This involves drinking the <strong>sea salt water mixture</strong> or, alternatively, a cup of <strong>herbal laxative tea</strong>. This step helps stimulate the body’s elimination process and assists in clearing the digestive tract.',
      'The Lemon Detox drink can be made fresh in the morning or prepared the night before if more convenient. The full daily batch can be taken with you to work if necessary.',
    ],
  },
  {
    key: 'day', when: 'Through the day', title: 'Drink it gradually and consistently.', img: 'hiw-day',
    alt: 'A woman in a white top sipping the Lemon Detox drink beside a jug and fresh lemons',
    body: [
      'The Lemon Detox drink is consumed regularly throughout the day.',
      'The mixture provides <strong>liquid nourishment</strong> and helps sustain energy while giving the digestive system a temporary break from processing solid food.',
      'Additional water is also consumed throughout the day to help the elimination process.',
    ],
  },
  {
    key: 'evening', when: 'Evening', title: 'Senna tea, then rest.', img: 'hiw-evening',
    alt: 'A woman relaxing in the evening light with a glass of the Lemon Detox drink and a bowl of lemons',
    body: [
      'Once the daily Lemon Detox drink mixture has been consumed, a cup of <strong>herbal laxative tea</strong> is taken before bed. This helps support the body’s elimination process during the cleanse.',
      'Adequate rest is encouraged during the program while the body continues its natural cleansing and restorative processes overnight.',
    ],
  },
] as const;

const ingredients = [
  { img: 'ing-syrup', alt: 'Natural tree syrup being poured into a small glass', name: 'Madal Bal® Natural Tree Syrup', body: 'The key ingredient, a balanced blend of Canadian Grade C maple syrup and the purest Palm syrups providing energy in the form of easily digestible carbohydrates and a high level of potassium.', fit: 'cover' },
  { img: 'ing-lemon', alt: 'A hand squeezing a fresh lemon into a small glass', name: 'Fresh Lemon Juice', body: 'Freshly squeezed lemons provide vitamin C and citrus polyphenols. Traditionally valued for their cleansing properties, a refreshing flavour while supporting the body’s own detoxification pathways.', fit: 'cover' },
  { img: 'ing-cayenne', alt: 'Ground cayenne pepper on a wooden spoon beside dried chillies', name: 'Cayenne Pepper', body: 'Helps stimulate circulation and support metabolism during the cleanse, while also adding a pleasant warmth to the drink.', fit: 'cover' },
  { img: 'ing-water', alt: 'Pure water being poured into a glass', name: 'Pure Water', body: 'Clean, pure water helps carry the formula through the body while maintaining hydration during the cleanse and supporting the body’s natural cleansing processes.', fit: 'cover', icon: true },
];

const versions = [
  {
    img: 'way-full', alt: 'A woman sitting by the pool with a glass of the Lemon Detox drink',
    name: 'Full Body Cleanse', tag: 'All meals replaced',
    body: 'In this version, all meals are replaced with the Lemon Detox drink, allowing the body to remain in a continuous cleansing state.',
    meals: [['Breakfast', '2–3 glasses'], ['Lunch', '2–3 glasses'], ['Dinner', '2–3 glasses']],
    note: 'This version can be followed for a minimum of 7 days, although 10–14 days is considered the ideal duration.',
  },
  {
    img: 'way-relaxed', alt: 'A couple sharing a light, healthy lunch alongside glasses of the Lemon Detox drink',
    name: 'Relaxed Version', tag: 'One healthy meal per day',
    body: 'A more flexible approach that allows the cleanse to fit around everyday routines. Breakfast and dinner are replaced with the Lemon Detox drink, while a healthy meal is eaten at lunch.',
    meals: [['Breakfast', '2–3 glasses'], ['Lunch', 'Healthy meal'], ['Dinner', '2–3 glasses']],
    note: 'This version is typically followed for at least two weeks and provides a gentler approach to the Lemon Detox program while still supporting the body’s natural cleansing processes.',
  },
  {
    img: 'way-5050', alt: 'A smiling woman holding a glass of the Lemon Detox drink at an outdoor café',
    name: '50/50 Version', tag: 'Gradual transition',
    body: 'This version combines the Relaxed Version and the Full Body Cleanse, allowing the body to gradually transition into the full cleanse. Makes it easier to fit around social or work commitments.',
    meals: [['Days 1–3', 'Relaxed Version'], ['Days 4–6', 'Full Body Cleanse'], ['Days 7–9', 'Relaxed Version']],
    note: 'Total program duration: 9 days if purchasing the 7 Day Pack. 18 days if purchasing the 14 Day Pack.',
  },
];
---
<Base title="How It Works — Lemon Detox Cleanse" description="The daily routine, the Lemon Detox drink, mixing instructions, elimination support and the three ways to follow the Lemon Detox Cleanse.">
  <!-- 01 · Overview -->
  <section id="program" class="scroll-mt-40" data-hero aria-labelledby="program-h">
    <div class="wrap !max-w-[1320px] grid items-center gap-14 pt-16 pb-20 lg:grid-cols-[1.05fr_1fr] lg:gap-20 lg:pt-24 lg:pb-28">
      <div>
        <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="01" aria-hidden="true"></p>
        <p class="eyebrow mt-2">The program</p>
        <h1 id="program-h" class="display-xl mt-6 !text-[clamp(2.9rem,5.4vw,5rem)] !leading-[1.05]">How the Lemon Detox Cleanse <em>works.</em></h1>
        <span class="rule !w-24" aria-hidden="true"></span>
        <div class="mt-8 max-w-xl space-y-5 text-[1.05rem] text-ink-soft">
          <p>The Lemon Detox Cleanse is undertaken over a defined 7 or up to 14 day timeframe. During this period, solid food is temporarily removed and replaced with a simple liquid routine centred around the Lemon Detox drink.</p>
          <p>The program is designed to simplify intake and create a deliberate pause from constant consumption. Temporarily abstaining from solid food allows the body to rest from constant digestion and re-establish its natural cleansing and metabolic balance.</p>
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/#programs" class={`btn btn-primary btn-caps ${sq} !min-h-[3.5rem] !px-8`}>View programs <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href="#rhythm" class={`btn btn-secondary btn-caps ${sq} !min-h-[3.5rem] !border-ink/40 !px-8`}>See a typical day</a>
        </div>
      </div>
      <div class="relative">
        <ImageSlot name="hiw-hero" alt="A glass jug of the Lemon Detox drink with fresh lemons" eager class="zoom-img aspect-[5/4] rounded-[22px] bg-paper shadow-[0_40px_60px_-40px_rgba(26,26,26,0.4)]" sizes="(min-width: 1024px) 600px, 100vw" />
        <div class="absolute -bottom-8 left-0 rounded-[14px] bg-white px-6 py-5 shadow-[0_20px_40px_-20px_rgba(26,26,26,0.35)] sm:-left-6">
          <p class="text-[0.62rem] font-semibold tracking-[0.25em] text-gold-deep uppercase">Defined arc</p>
          <p class="mt-1.5 font-serif text-xl leading-snug text-ink">7 to 14 days.<br />One clear rhythm.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section menu -->
  <nav aria-label="On this page" class="sticky top-[5.5rem] z-20 border-y border-black/[0.06] bg-paper/95 backdrop-blur">
    <ul class="wrap !max-w-[1320px] flex gap-2 overflow-x-auto py-3 text-[0.68rem] tracking-[0.2em] whitespace-nowrap uppercase [scrollbar-width:none]">
      {nav.map(([id, l]) => <li><a href={`#${id}`} class="block rounded-full px-4 py-2 text-muted transition hover:text-ink" data-toc={id}>{l}</a></li>)}
    </ul>
  </nav>

  <!-- 02 · The pause -->
  <section id="pause" class="scroll-mt-40 bg-paper py-20 lg:py-28" aria-labelledby="pause-h">
    <div class="wrap !max-w-[1320px] grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-0">
      <div class="lg:pr-14" data-reveal>
        <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="02" aria-hidden="true"></p>
        <p class="eyebrow mt-2">The pause</p>
        <h2 id="pause-h" class="mt-4 text-[clamp(2rem,3.2vw,2.8rem)] leading-[1.12]">Why choose the <em>Lemon Detox Cleanse.</em></h2>
      </div>
      <div class="space-y-5 text-ink-soft lg:border-l lg:border-black/[0.08] lg:pl-14" data-reveal style="--d:100ms">
        <p class="font-serif text-[1.5rem] leading-snug text-ink">Modern life is fast, demanding, and often excessive. Convenience foods, constant snacking, and busy schedules can leave little space for awareness or balance.</p>
        <p>The body is designed to regulate and maintain itself. However, when routines become overloaded, many people feel out of rhythm — heavier, less focused, and lacking clarity.</p>
        <p>The Lemon Detox Cleanse provides a structured pause. By temporarily replacing solid food with a simple liquid routine, the program reduces digestive demand and creates space for recalibration.</p>
        <p>By simplifying intake and removing decision fatigue around food, many participants experience weight loss, improved awareness, and renewed control over their habits.</p>
        <p class="font-serif text-[1.25rem] text-ink italic">The value of the program lies not in extremes, but in structure, consistency, and intention.</p>
      </div>
    </div>
  </section>

  <!-- 03 · Daily rhythm (timeline) -->
  <section id="rhythm" class="scroll-mt-40 py-20 lg:py-28" aria-labelledby="rhythm-h">
    <div class="wrap !max-w-[1320px]">
      <div class="max-w-2xl" data-reveal>
        <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="03" aria-hidden="true"></p>
        <p class="eyebrow mt-2">Daily rhythm</p>
        <h2 id="rhythm-h" class="mt-4 text-[clamp(2.2rem,3.8vw,3.4rem)] leading-[1.1]">A typical day on the <em>Lemon Detox Cleanse.</em></h2>
        <p class="mt-5 text-ink-soft">The program follows a simple daily rhythm designed to support detoxification, elimination, and the required energy throughout the cleanse.</p>
      </div>
      <ol class="relative mt-16 space-y-16 lg:space-y-24">
        <span class="absolute top-0 bottom-0 left-1/2 hidden w-px bg-black/[0.08] lg:block" aria-hidden="true"></span>
        {day.map((d, i) => (
          <li class="relative grid items-center gap-8 lg:grid-cols-2 lg:gap-28" data-reveal>
            <span class="absolute top-0 left-1/2 z-10 hidden h-10 w-10 -translate-x-1/2 place-items-center rounded-full border border-gold/50 bg-white font-serif text-sm text-gold-deep lg:grid" aria-hidden="true">{['I', 'II', 'III'][i]}</span>
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <ImageSlot name={d.img} alt={d.alt} class="zoom-img aspect-[4/3] rounded-[22px] bg-paper shadow-[0_30px_50px_-30px_rgba(26,26,26,0.4)]" sizes="(min-width: 1024px) 560px, 100vw" />
              {d.key === 'evening' && <p class="mt-6 font-serif text-[1.1rem] text-ink italic">The routine quickly becomes simple and repetitive — leaving you free to focus on rest, hydration, and the cleanse itself.</p>}
            </div>
            <div>
              <p class="flex items-center gap-2.5 text-[0.7rem] font-semibold tracking-[0.25em] text-gold-deep uppercase"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[d.key]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>{d.when}</p>
              <h3 class="mt-3 text-[clamp(1.6rem,2.4vw,2.1rem)] leading-snug">{d.title}</h3>
              <div class="mt-4 space-y-3 text-[0.98rem] text-ink-soft">{d.body.map((b) => <p set:html={b} />)}</div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 · The formula -->
  <section id="formula" class="scroll-mt-40 bg-paper py-20 lg:py-28" aria-labelledby="formula-h">
    <div class="wrap !max-w-[1320px]">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20" data-reveal>
        <div>
          <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="04" aria-hidden="true"></p>
        <p class="eyebrow mt-2">The formula</p>
          <h2 id="formula-h" class="mt-4 text-[clamp(2.2rem,3.8vw,3.4rem)] leading-[1.1]">What is the <em>Lemon Detox drink.</em></h2>
        </div>
        <div class="space-y-4 text-ink-soft lg:pt-8">
          <p>The Lemon Detox program centres around a simple drink made from the <strong class="text-ink">Madal Bal® Natural Tree Syrup</strong>, fresh lemon juice, cayenne pepper and pure water.</p>
          <p>During the cleanse, this drink replaces regular meals while supplying your body with natural carbohydrates, minerals and hydration. The digestive system rests — yet you remain energised throughout the day. Simple liquid nourishment!</p>
        </div>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ingredients.map((g, i) => (
          <article class="lift flex flex-col overflow-hidden rounded-[18px] border border-gold-soft/70 bg-white" data-reveal style={`--d:${i * 80}ms`}>
            <ImageSlot name={g.img} alt={g.alt} class="zoom-img aspect-[4/3] bg-paper" sizes="(min-width: 1024px) 300px, 50vw" />
            <div class="flex-1 p-7">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-lemon/20 text-gold-deep" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24"><path d={ingIcons[i]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <h3 class="mt-5 text-[1.3rem] leading-snug">{g.name}</h3>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-soft">{g.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 · Mixing -->
  <section id="mixing" class="scroll-mt-40 py-20 lg:py-28" aria-labelledby="mix-h">
    <div class="wrap !max-w-[1320px]">
      <div class="grid items-end gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20" data-reveal>
        <div>
          <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="05" aria-hidden="true"></p>
        <p class="eyebrow mt-2">Mixing</p>
          <h2 id="mix-h" class="mt-4 text-[clamp(2.2rem,3.8vw,3.4rem)] leading-[1.1]">Daily mixing <em>instructions.</em></h2>
        </div>
        <p class="text-ink-soft lg:pb-2">The Lemon Detox drink is simple, natural and easy to prepare. Fresh ingredients give the best flavour and the most effective cleanse experience.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {[
          { t: 'For a 2-litre batch', sub: 'Preferred for the whole day', rec: true, items: [['140 ml', 'Madal Bal® Natural Tree Syrup'], ['3½', 'freshly squeezed lemons (approximately 140 ml juice)'], ['2–3 pinches', 'of cayenne pepper'], ['≈ 1700 ml', 'fresh or filtered water']] },
          { t: 'Per glass', sub: 'Quick single-glass version', items: [['1 tbsp (20 ml)', 'Madal Bal® Natural Tree Syrup'], ['1 tbsp', 'freshly squeezed lemon juice (about half a lemon)'], ['½ pinch', 'cayenne pepper, adjusted to taste'], ['≥ 250 ml', 'fresh or filtered water']] },
        ].map((m, i) => (
          <div class:list={['rounded-[18px] border bg-white p-8 sm:p-10', m.rec ? 'border-gold/60' : 'border-gold-soft/70']} data-reveal style={`--d:${i * 90}ms`}>
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-sans text-[0.75rem] font-semibold tracking-[0.25em] text-gold-deep uppercase">{m.t}</h3>
                <p class="mt-1 text-[0.7rem] tracking-[0.2em] text-muted uppercase">{m.sub}</p>
              </div>
              {m.rec && <span class="bg-lemon/25 px-2.5 py-1 text-[0.6rem] font-semibold tracking-[0.2em] text-gold-deep uppercase">Preferred</span>}
            </div>
            <ol class="mt-7 space-y-4 text-[0.98rem] text-ink-soft">
              {m.items.map(([q, t], j) => <li class="flex gap-5"><span class="w-6 font-serif text-gold-deep">{String(j + 1).padStart(2, '0')}</span><span><strong class="text-ink">{q}</strong> {t}</span></li>)}
            </ol>
          </div>
        ))}
      </div>
      <div class="mt-8 grid gap-4 text-sm text-ink-soft sm:grid-cols-3">
        <p><strong class="text-ink">Mix well</strong> before drinking.</p>
        <p>Enjoy <strong class="text-ink">cold, room temperature, or warm</strong> — whichever you prefer.</p>
        <p>After opening, keep the Madal Bal tin <strong class="text-ink">refrigerated</strong>.</p>
      </div>
    </div>
  </section>

  <!-- 06 · Elimination -->
  <section id="elimination" class="scroll-mt-40 bg-paper py-20 lg:py-28" aria-labelledby="elim-h">
    <div class="wrap !max-w-[1320px] grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div data-reveal>
        <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="06" aria-hidden="true"></p>
        <p class="eyebrow mt-2">Elimination</p>
        <h2 id="elim-h" class="mt-4 text-[clamp(2.2rem,3.8vw,3.4rem)] leading-[1.1]">The key to a <em>successful program.</em></h2>
        <div class="mt-6 space-y-4 text-ink-soft">
          <p><strong class="text-ink">Effective elimination</strong> is the key to a successful Lemon Detox program, helping the body remove waste products released during the cleanse.</p>
          <p><strong class="text-ink">Sea Salt and Senna Tea are provided</strong> to help stimulate the body’s natural elimination process during the cleanse.</p>
        </div>
      </div>
      <div class="space-y-5" data-reveal style="--d:100ms">
        <article class="rounded-[18px] border border-gold-soft/70 bg-white p-7 sm:p-8">
          <h3 class="flex items-center gap-4 font-sans text-[0.95rem] font-semibold tracking-[0.2em] text-gold-deep uppercase"><span class="grid h-12 w-12 place-items-center rounded-full bg-lemon/20" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24"><path d={icons.morning} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>Morning · Sea salt water</h3>
          <p class="mt-4 text-ink-soft">Dissolve <strong class="text-ink">two teaspoons of natural, uniodised sea salt</strong> in <strong class="text-ink">one litre of warm purified water</strong> and drink it <strong class="text-ink">on an empty stomach</strong>.</p>
        </article>
        <article class="rounded-[18px] border border-gold-soft/70 bg-white p-7 sm:p-8">
          <h3 class="flex items-center gap-4 font-sans text-[0.95rem] font-semibold tracking-[0.2em] text-gold-deep uppercase"><span class="grid h-12 w-12 place-items-center rounded-full bg-lemon/20" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24"><path d={icons.evening} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>Evening · Herbal senna tea</h3>
          <p class="mt-4 text-ink-soft"><strong class="text-ink">Senna tea</strong>, a mild herbal laxative <strong class="text-ink">taken before bed</strong>, supports overnight elimination of waste released during the cleanse.</p>
        </article>
        <p class="pt-2 text-sm text-ink-soft">Also drink <strong class="text-ink">1–2 litres of fresh water each day</strong>. <strong class="text-ink">Dry skin brushing</strong> and <strong class="text-ink">light exercise</strong> may also complement the program.</p>
      </div>
    </div>
  </section>

  <!-- 07 · Versions -->
  <section id="versions" class="scroll-mt-40 py-20 lg:py-28" aria-labelledby="ver-h">
    <div class="wrap !max-w-[1320px]">
      <div class="max-w-2xl" data-reveal>
        <p class="sec-num decor-num font-serif leading-none text-gold/45" data-n="07" aria-hidden="true"></p>
        <p class="eyebrow mt-2">Versions</p>
        <h2 id="ver-h" class="mt-4 text-[clamp(2.2rem,3.8vw,3.4rem)] leading-[1.1]">Choose the cleanse <em>that suits you.</em></h2>
        <p class="mt-5 text-ink-soft">Choose the version that best suits your lifestyle and experience level.</p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {versions.map((v, i) => (
          <article class:list={['lift flex flex-col overflow-hidden rounded-[18px] border bg-white', i === 0 ? 'border-gold/60' : 'border-gold-soft/70']} data-reveal style={`--d:${i * 90}ms`}>
            <ImageSlot name={v.img} alt={v.alt} class="zoom-img aspect-[4/3] bg-paper" sizes="(min-width: 1024px) 400px, 100vw" />
            <div class="flex flex-1 flex-col p-7">
              {i === 0 && <span class="mb-3 self-start bg-lemon/25 px-2.5 py-1 text-[0.6rem] font-semibold tracking-[0.2em] text-gold-deep uppercase">Deepest reset</span>}
              <p class="text-[0.68rem] font-semibold tracking-[0.22em] text-gold-deep uppercase">{v.tag}</p>
              <h3 class="mt-2 text-[1.6rem]">{v.name}</h3>
              <p class="mt-3 text-[0.94rem] text-ink-soft">{v.body}</p>
              <ul class="mt-5 space-y-2 text-[0.9rem] text-ink">
                {v.meals.map(([k, val]) => <li class="flex items-start gap-3"><svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true" class="mt-1 shrink-0 text-gold-deep"><path d="M2.5 6.2 5 8.6l4.6-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>{k} · {val}</li>)}
              </ul>
              <p class="mt-5 text-sm text-muted italic">{v.note}</p>
            </div>
          </article>
        ))}
      </div>
      <a href="/#programs" class="mt-10 flex items-center justify-center gap-3 bg-ink px-6 py-6 text-center text-sm font-medium tracking-[0.3em] text-white uppercase transition hover:bg-gold-deep" data-reveal>
        Start your cleanse today
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </section>

  <!-- 08 · Depth -->
