  <script>
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
    const set = (id: string) => links.forEach((a) => {
      const on = a.dataset.toc === id;
      a.classList.toggle('!bg-ink', on);
      a.classList.toggle('!text-white', on);
      on ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current');
      if (on) { const ul = a.closest('ul')!; ul.scrollTo({ left: a.offsetLeft - ul.clientWidth / 2 + a.offsetWidth / 2, behavior: 'smooth' }); }
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set(e.target.id)), { rootMargin: '-35% 0px -60% 0px' });
    document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));
    // Timeline line fills in gold as you scroll through the day
    const tl = document.getElementById('timeline');
    const fill = document.getElementById('timeline-fill');
    if (tl && fill) {
      const upd = () => {
        const r = tl.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
        fill.style.setProperty('--tl', matchMedia('(prefers-reduced-motion: reduce)').matches ? '1' : String(p));
      };
      upd(); addEventListener('scroll', upd, { passive: true }); addEventListener('resize', upd);
    }
  </script>
</Base>
